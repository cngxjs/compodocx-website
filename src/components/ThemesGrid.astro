---
import SectionEyebrow from './SectionEyebrow.astro';
import defaultCss from '../styles/vendor/compodocx/compodocx.css?raw';
import oceanCss from '../styles/vendor/compodocx/themes/ocean.css?raw';
import midnightCss from '../styles/vendor/compodocx/themes/midnight.css?raw';
import nordCss from '../styles/vendor/compodocx/themes/nord.css?raw';
import rosePineCss from '../styles/vendor/compodocx/themes/rose-pine.css?raw';
import emberCss from '../styles/vendor/compodocx/themes/ember.css?raw';
import neonCss from '../styles/vendor/compodocx/themes/neon.css?raw';
import brutalistCss from '../styles/vendor/compodocx/themes/brutalist.css?raw';

interface ThemeMeta {
  id: string;
  name: string;
  blurb: string;
  source: string;
}

const TOKENS_TO_EXTRACT = [
  '--color-cdx-bg',
  '--color-cdx-bg-alt',
  '--color-cdx-bg-elevated',
  '--color-cdx-primary',
  '--color-cdx-text',
];

const themeMetas: ThemeMeta[] = [
  {
    id: 'default',
    name: 'Slate Noir',
    blurb: 'Neutral greys, no accent hue. The opinion-free default.',
    source: defaultCss,
  },
  {
    id: 'ocean',
    name: 'Ocean',
    blurb: 'Cool teal surfaces with github-light / github-dark Shiki.',
    source: oceanCss,
  },
  {
    id: 'midnight',
    name: 'Midnight',
    blurb: 'Indigo night, low contrast. Pairs with tokyo-night Shiki.',
    source: midnightCss,
  },
  {
    id: 'nord',
    name: 'Nord',
    blurb: 'Arctic palette, frost blue, calm primary. Dark-only Shiki.',
    source: nordCss,
  },
  {
    id: 'rose-pine',
    name: 'Rose Pine',
    blurb: 'Warm rose with muted greens and golden accents.',
    source: rosePineCss,
  },
  {
    id: 'ember',
    name: 'Ember',
    blurb: 'Warm amber on ember-grey, easy on the eyes for long reads.',
    source: emberCss,
  },
  {
    id: 'neon',
    name: 'Neon',
    blurb: 'High-contrast electric primary on dark slate. Synthwave-84 Shiki.',
    source: neonCss,
  },
  {
    id: 'brutalist',
    name: 'Brutalist',
    blurb: 'Hard edges, raw surfaces, maximum legibility.',
    source: brutalistCss,
  },
];

interface ThemeWithSwatches extends Omit<ThemeMeta, 'source'> {
  swatches: Record<string, string>;
}

function extractTokens(css: string): Record<string, string> {
  const result: Record<string, string> = {};
  for (const token of TOKENS_TO_EXTRACT) {
    const match = css.match(new RegExp(`${token}\\s*:\\s*([^;]+);`));
    if (match) result[token] = match[1].trim();
  }
  return result;
}

const themes: ThemeWithSwatches[] = themeMetas.map(({ source, ...rest }) => ({
  ...rest,
  swatches: extractTokens(source),
}));
---

<section id="themes" class="mx-auto max-w-6xl px-4 py-24" aria-labelledby="themes-heading">
  <hgroup>
    <SectionEyebrow text="Themes" />
    <h2 id="themes-heading" class="text-cdx-text mt-3 text-3xl font-semibold tracking-tight">
      Click a card. The whole site flips.
    </h2>
  </hgroup>
  <p class="text-cdx-text-secondary mt-3 max-w-2xl leading-relaxed">
    Eight themes ship with compodocx. Try them live: your pick persists across pages. Want your own?
    Override any subset of <code class="cdx-code">--color-cdx-*</code>
    <a
      href={`${import.meta.env.BASE_URL}guides/themes/`}
      class="text-cdx-primary underline underline-offset-2">tokens in a single CSS file</a
    >.
  </p>

  <div
    class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4"
    role="radiogroup"
    aria-label="Select a theme"
  >
    {
      themes.map((theme) => (
        <button
          type="button"
          role="radio"
          data-theme-id={theme.id}
          aria-checked="false"
          class="bg-cdx-bg-elevated focus-visible:ring-cdx-primary aria-checked:ring-cdx-primary group relative grid cursor-pointer grid-rows-[auto_auto_1fr] gap-3 rounded-xl p-4 text-left transition aria-checked:ring-2 focus-visible:ring-2 focus-visible:outline-none"
