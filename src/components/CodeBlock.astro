---
interface Props {
  lang: string;
  code: string;
  id?: string;
  filename?: string;
}

const { lang, code, id, filename } = Astro.props;
const codeId = id ?? `code-${Math.random().toString(36).slice(2, 11)}`;
---

<div
  class="bg-cdx-bg-alt/60 ring-cdx-border/40 cdx-codeblock grid grid-cols-[minmax(0,1fr)] overflow-hidden rounded-lg ring-1"
>
  <div class="border-cdx-border/30 flex items-center justify-between gap-3 border-b px-3 py-1.5">
    <span
      class="text-cdx-text-secondary inline-flex items-center gap-2 font-mono text-[10px] tracking-[0.15em] uppercase"
    >
      <span>{lang}</span>
      {
        filename && (
          <span class="text-cdx-text-secondary font-mono normal-case tracking-normal">
            {filename}
          </span>
        )
      }
    </span>
    <button
      type="button"
      data-copy-target={codeId}
      aria-label={`Copy ${lang} code`}
      class="copy-btn group text-cdx-text-secondary hover:text-cdx-text data-[copied=true]:text-cdx-primary inline-flex size-6 items-center justify-center rounded transition-colors"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class="copy-icon-default"
      >
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
      </svg>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class="copy-icon-done"
      >
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <span class="sr-only" data-copy-live aria-live="polite"></span>
    </button>
  </div>
  {/* prettier-ignore */}
  <pre
    class="text-cdx-text overflow-x-auto p-4 font-mono text-xs leading-relaxed"><code id={codeId}>{code}</code></pre>
</div>

<script>
  import { initCopyButtons } from '../scripts/copy-button';
  document.addEventListener('astro:page-load', () => initCopyButtons());
</script>
