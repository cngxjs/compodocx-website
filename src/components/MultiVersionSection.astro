---
import { Image, getImage } from 'astro:assets';
import SectionEyebrow from './SectionEyebrow.astro';
import lqipMap from '../assets/screenshots/lqip.json';

import multiVersionLight from '../assets/screenshots/multi-version-light.png';
import multiVersionDark from '../assets/screenshots/multi-version-dark.png';

const altText =
  'compodocx component page with the version-switcher dropdown open in the topbar, showing v1.1.0 active and v1.0.0 below';

const fullLight = (
  await getImage({ src: multiVersionLight, width: 2048, format: 'avif', quality: 80 })
).src;
const fullDark = (
  await getImage({ src: multiVersionDark, width: 2048, format: 'avif', quality: 80 })
).src;
const lqip = lqipMap as Record<string, string>;
---

<section class="mx-auto max-w-6xl px-4 py-24" aria-labelledby="multi-version-heading">
  <div class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
    <figure class="lg:order-1">
      <button
        type="button"
        class="screenshot-zoom group bg-cdx-bg-elevated relative block aspect-[16/10] w-full cursor-zoom-in overflow-hidden rounded-xl"
        data-zoom-light={fullLight}
        data-zoom-dark={fullDark}
        data-zoom-alt={altText}
        style={`--lqip-light:url('${lqip['multi-version-light']}'); --lqip-dark:url('${lqip['multi-version-dark']}');`}
        aria-label="View multi-version switcher screenshot at full resolution"
      >
        <Image
          src={multiVersionLight}
          alt={altText}
          class="absolute inset-0 size-full object-cover dark:hidden"
          loading="lazy"
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 512px, 100vw"
        />
        <Image
          src={multiVersionDark}
          alt={altText}
          class="absolute inset-0 hidden size-full object-cover dark:block"
          loading="lazy"
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 512px, 100vw"
        />
        <span
          aria-hidden="true"
          class="bg-cdx-bg-elevated/90 text-cdx-text-secondary absolute right-3 top-3 inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium opacity-0 backdrop-blur transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
            <path d="M11 8v6"></path>
            <path d="M8 11h6"></path>
          </svg>
          Click to zoom
        </span>
      </button>
    </figure>

    <div class="lg:order-2">
      <hgroup>
        <SectionEyebrow text="Versioning" />
        <h2
          id="multi-version-heading"
          class="text-cdx-text mt-3 text-3xl font-semibold tracking-tight"
        >
          Every release. One domain. Zero config.
        </h2>
      </hgroup>
      <p class="text-cdx-text-secondary mt-4 leading-relaxed">
        Each release writes into its own folder under a shared root. A
        <code class="cdx-code">versions.json</code> manifest drives the version-switcher in the topbar.
        Append-only, semver-sorted, no server-side config.
      </p>
      <ul class="text-cdx-text-secondary mt-8 space-y-5 text-sm">
        <li class="flex gap-3.5">
          <span
            class="bg-cdx-primary/10 text-cdx-primary mt-0.5 inline-flex size-7 shrink-0 items-center justify-center rounded-md"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"
              ></path>
            </svg>
          </span>
          <span class="leading-relaxed">
            <span class="text-cdx-text font-semibold">Auto-detected label.</span>
            Read from the nearest <code class="cdx-code">package.json</code>, or override with
            <code class="cdx-code">--versionLabel</code>.
          </span>
        </li>
        <li class="flex gap-3.5">
          <span
            class="bg-cdx-primary/10 text-cdx-primary mt-0.5 inline-flex size-7 shrink-0 items-center justify-center rounded-md"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 8v4l3 3"></path>
              <path d="M3.05 11a9 9 0 1 1 .5 4"></path>
              <polyline points="3 4 3 11 10 11"></polyline>
            </svg>
          </span>
          <span class="leading-relaxed">
            <span class="text-cdx-text font-semibold">Append-only manifest.</span>
            Deduplicated by label — past links never break when a new release ships.
          </span>
        </li>
        <li class="flex gap-3.5">
          <span
            class="bg-cdx-primary/10 text-cdx-primary mt-0.5 inline-flex size-7 shrink-0 items-center justify-center rounded-md"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M16 3h5v5"></path>
              <path d="M8 3H3v5"></path>
              <path d="M21 16v5h-5"></path>
              <path d="M3 16v5h5"></path>
              <path d="m21 3-6 6"></path>
              <path d="m3 21 6-6"></path>
            </svg>
          </span>
          <span class="leading-relaxed">
            <span class="text-cdx-text font-semibold">Runtime switcher.</span>
            Reads the manifest in the browser — works on GitHub Pages, S3, intranets, even
            <code class="cdx-code">file://</code>.
          </span>
        </li>
      </ul>
    </div>
  </div>
</section>
