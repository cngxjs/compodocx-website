---
import SectionEyebrow from './SectionEyebrow.astro';

export interface FaqItem {
  question: string;
  /** Plain-text answer - used for FAQPage JSON-LD (schema.org requires plain text). */
  answer: string;
  /** Optional rich-HTML version used for the visible UI. Falls back to `answer`. */
  answerHtml?: string;
}

export const faq: FaqItem[] = [
  {
    question: 'Is compodocx compatible with compodoc?',
    answer:
      'Yes. compodocx is a drop-in fork. The compodoc CLI alias still works, and a compodocx migrate command ports Handlebars overrides to JS partials automatically.',
    answerHtml:
      '<strong class="text-cdx-text">Yes.</strong> compodocx is a drop-in fork. The <code class="cdx-code">compodoc</code> CLI alias still works, and <code class="cdx-code">compodocx migrate</code> ports Handlebars overrides to JS partials automatically.',
  },
  {
    question: 'Does compodocx support Angular Signals and standalone components?',
    answer:
      'Yes. signal, computed, and linked-signal members render as first-class fields with derived-state dependencies. Standalone components, directives, and pipes are documented without NgModule scaffolding.',
    answerHtml:
      '<strong class="text-cdx-text">Yes.</strong> <code class="cdx-code">signal()</code>, <code class="cdx-code">computed()</code>, and <code class="cdx-code">linkedSignal()</code> members render as first-class fields with derived-state dependencies.<br /><br />Standalone components, directives, and pipes are documented - no <code class="cdx-code">NgModule</code> scaffolding needed.',
  },
  {
    question: 'Can I generate docs for multiple library versions?',
    answer:
      'Yes. Multi-version output is the default. compodocx detects the version from package.json, writes a versions.json manifest, and ships a runtime version-switcher widget - no server-side config needed.',
    answerHtml:
      '<strong class="text-cdx-text">Yes.</strong> Multi-version output is the default. compodocx detects the version from <code class="cdx-code">package.json</code>, writes a <code class="cdx-code">versions.json</code> manifest, and ships a runtime version-switcher widget.<br /><br />No server-side config needed.',
  },
  {
    question: 'How do I theme compodocx output?',
    answer:
      'Eight themes ship in the box (Slate Noir, Ocean, Midnight, Nord, Rose Pine, Ember, Neon, Brutalist). Roll your own by overriding any subset of the --color-cdx-* CSS custom properties in a single CSS file passed via --theme.',
    answerHtml:
      '<strong class="text-cdx-text">Eight themes ship in the box:</strong> Slate Noir, Ocean, Midnight, Nord, Rose Pine, Ember, Neon, Brutalist.<br /><br />Roll your own by overriding any subset of <code class="cdx-code">--color-cdx-*</code> CSS custom properties in a single CSS file passed via <code class="cdx-code">--theme</code>.',
  },
  {
    question: 'Does compodocx integrate with CI?',
    answer:
      'Yes. compodocx diff compares two JSON snapshots and exits non-zero on breaking changes. --exportFormat json emits a typed schema with schemaVersion. --coverageMinimum gates merges on documentation completeness.',
    answerHtml:
      '<strong class="text-cdx-text">Yes.</strong> Three CI hooks ship in the box:<ul class="mt-3 list-disc space-y-2 pl-5"><li><code class="cdx-code">compodocx diff</code> compares two JSON snapshots and exits non-zero on breaking changes.</li><li><code class="cdx-code">--exportFormat json</code> emits a typed schema with a stable <code class="cdx-code">schemaVersion</code>.</li><li><code class="cdx-code">--coverageMinimum</code> gates merges on documentation completeness.</li></ul>',
  },
  {
    question: 'Can I ship runnable demos with my docs?',
    answer:
      'Yes. Add a @playground JSDoc block to a component and compodocx renders a Playground tab on its page with one launch button per block. Clicking opens a fresh StackBlitz project assembled at build time from your component sources. The SDK is lazy-loaded as a ~7 KB chunk on first click.',
    answerHtml:
      '<strong class="text-cdx-text">Yes.</strong> Add a <code class="cdx-code">@playground</code> JSDoc block to a component and compodocx renders a <em>Playground</em> tab with one launch button per block.<br /><br />Clicking opens a fresh StackBlitz project assembled at build time from your component sources. No library publication required. The SDK is lazy-loaded as a ~7 KB chunk on first click, so static doc pages stay light.',
  },
  {
    question: 'Does compodocx surface accessibility metadata?',
    answer:
      'Yes. Annotate any entity with @wcag A, AA, or AAA and a coloured chip lands in the page hero. Add @a11y for a free-form note attached to the entity for the llm-md export. The WCAG level also feeds the search-palette facet rail so a reader can filter the index to "AA and up".',
    answerHtml:
      '<strong class="text-cdx-text">Yes.</strong> Annotate any entity with <code class="cdx-code">@wcag A</code>, <code class="cdx-code">AA</code>, or <code class="cdx-code">AAA</code> and a coloured chip lands in the page hero. Add <code class="cdx-code">@a11y</code> for a free-form note attached to the entity for the <code class="cdx-code">llm-md</code> export.<br /><br />The WCAG level also feeds the search-palette facet rail so a reader can filter the index to "AA and up".',
  },
  {
    question: 'Is compodocx free?',
    answer:
      'Yes. compodocx is open source under the MIT license. The compodoc upstream attribution to Vincent Ogloblinsky is preserved.',
    answerHtml:
      '<strong class="text-cdx-text">Yes.</strong> compodocx is open source under the <strong class="text-cdx-text">MIT license</strong>.<br /><br />The compodoc upstream attribution to Vincent Ogloblinsky is preserved.',
  },
];
---

<section class="mx-auto max-w-3xl px-4 py-24" aria-labelledby="faq-heading">
  <hgroup>
    <SectionEyebrow text="FAQ" />
    <h2 id="faq-heading" class="text-cdx-text mt-3 text-3xl font-semibold tracking-tight">
      Common questions
    </h2>
  </hgroup>
  <p class="text-cdx-text-secondary mt-3 leading-relaxed">
    Quick answers to the questions that come up before adoption. Still stuck? Open an issue on
    GitHub.
  </p>

  <ul class="mt-10 space-y-3">
    {
      faq.map((item, idx) => (
        <li>
          <details
            class="bg-cdx-bg-elevated faq-item group rounded-xl"
            open={idx === 0 ? true : undefined}
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-xl p-5">
              <h3 class="text-cdx-text text-base font-semibold tracking-tight">{item.question}</h3>
              <span
                aria-hidden="true"
                class="text-cdx-text-secondary group-hover:text-cdx-primary inline-flex size-8 shrink-0 items-center justify-center rounded-md transition-transform group-open:rotate-180"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </span>
            </summary>
            <div
              class="text-cdx-text-secondary px-5 pt-1 pb-5 leading-relaxed"
              set:html={item.answerHtml ?? item.answer}
            />
          </details>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* Hide the default disclosure triangle in Safari/Chrome */
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
</style>
