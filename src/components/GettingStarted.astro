---
import SectionEyebrow from './SectionEyebrow.astro';

interface Step {
  id: string;
  label: string;
  caption: string;
  code: string;
  lang: 'bash' | 'json';
}

const steps: Step[] = [
  {
    id: 'install',
    label: 'Install',
    caption:
      'Add it to your dev dependencies. <br />Works in any Angular library or app from Angular 17 upwards.',
    code: 'npm install -D @cngxjs/compodocx',
    lang: 'bash',
  },
  {
    id: 'run',
    label: 'Run',
    caption:
      'Point at your tsconfig. Static docs land in <code class="cdx-code">./documentation/&lt;versionLabel&gt;/</code>. <br />Label auto-detected from <code class="cdx-code">package.json</code>.',
    code: 'npx compodocx -p tsconfig.doc.json',
    lang: 'bash',
  },
  {
    id: 'configure',
    label: 'Configure',
    caption: 'Or commit a JSON config so everyone on the team runs the same flags. Pin the theme.',
    code: `{
  "tsconfig": "tsconfig.doc.json",
  "output": "documentation",
  "theme": "ocean"
}`,
    lang: 'json',
  },
];
---

<section id="install" class="mx-auto max-w-6xl px-4 py-24" aria-labelledby="install-heading">
  <hgroup>
    <SectionEyebrow text="Setup" />
    <h2 id="install-heading" class="text-cdx-text mt-3 text-3xl font-semibold tracking-tight">
      From zero to docs in 60 seconds
    </h2>
  </hgroup>
  <p class="text-cdx-text-secondary mt-3 max-w-2xl leading-relaxed">
    One command to install. One to run. The third is optional but recommended once your team is
    onboard.
  </p>

  <ol class="mt-12 grid gap-5 md:grid-cols-3">
    {
      steps.map((step, idx) => (
        <li class="bg-cdx-bg-elevated flex min-w-0 flex-col overflow-hidden rounded-xl">
          <header class="flex items-center gap-3 px-6 pt-6">
            <span
              aria-hidden="true"
              class="bg-cdx-primary text-cdx-text-inverse inline-flex size-9 items-center justify-center rounded-lg font-mono text-sm font-bold"
            >
              {String(idx + 1).padStart(2, '0')}
            </span>
            <h3 class="text-cdx-text text-base font-semibold tracking-tight">{step.label}</h3>
          </header>

          <p
            class="text-cdx-text-secondary mt-3 px-6 text-sm leading-relaxed"
            set:html={step.caption}
          />

          <div class="bg-cdx-bg-alt/60 ring-cdx-border/40 mx-6 mt-5 mb-6 min-w-0 overflow-hidden rounded-lg ring-1 lg:mt-auto">
            <div class="border-cdx-border/30 flex items-center justify-between border-b px-3 py-1.5">
              <span class="text-cdx-text-secondary font-mono text-[10px] tracking-[0.15em] uppercase">
                {step.lang}
              </span>
              <button
                type="button"
                data-copy-target={`gs-${step.id}-code`}
                aria-label={`Copy ${step.label} command`}
                class="copy-btn group text-cdx-text-secondary hover:text-cdx-text data-[copied=true]:text-cdx-primary inline-flex size-6 items-center justify-center rounded transition-colors"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="13"
                  height="13"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="copy-icon-default"
                >
                  <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
                  <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                </svg>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="13"
                  height="13"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="copy-icon-done"
                >
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <span class="sr-only" data-copy-live aria-live="polite" />
              </button>
            </div>
            {/* prettier-ignore */}
            <pre class="text-cdx-text overflow-x-auto p-3 font-mono text-xs leading-relaxed"><code id={`gs-${step.id}-code`}>{step.code}</code></pre>
          </div>
        </li>
      ))
    }
  </ol>
</section>
