---
import SectionEyebrow from './SectionEyebrow.astro';

interface Step {
  id: string;
  label: string;
  caption: string;
  code: string;
  lang: 'bash' | 'json';
}

const steps: Step[] = [
  {
    id: 'install',
    label: 'Install',
    caption: 'Add it to your dev dependencies. Works in any Angular library or app on Node 22+.',
    code: 'npm install --save-dev @cngxjs/compodocx',
    lang: 'bash',
  },
  {
    id: 'run',
    label: 'Run',
    caption:
      'Point at your tsconfig. Static docs land in ./documentation/<versionLabel>/. The label comes from package.json automatically.',
    code: 'npx compodocx -p tsconfig.doc.json',
    lang: 'bash',
  },
  {
    id: 'configure',
    label: 'Configure',
    caption: 'Or commit a JSON config so everyone on the team runs the same flags. Pin the theme.',
    code: `{
  "tsconfig": "tsconfig.doc.json",
  "output": "documentation",
  "theme": "ocean",
  "exportFormat": "html"
}`,
    lang: 'json',
  },
];
---

<section id="install" class="mx-auto max-w-6xl px-4 py-24" aria-labelledby="install-heading">
  <SectionEyebrow text="Setup" />
  <h2 id="install-heading" class="text-cdx-text mt-3 text-3xl font-semibold tracking-tight">
    From zero to docs in 60 seconds
  </h2>
  <p class="text-cdx-text-secondary mt-3 max-w-2xl leading-relaxed">
    One command to install. One to run. The third is optional but recommended once your team is
    onboard.
  </p>

  <div class="mt-12 grid gap-4 md:grid-cols-3">
    {
      steps.map((step, idx) => (
        <div class="bg-cdx-bg-elevated grid grid-rows-[auto_auto_1fr_auto] gap-3 rounded-xl p-5">
          <p class="text-cdx-text-muted font-mono text-xs tracking-wider uppercase">
            {String(idx + 1).padStart(2, '0')} · {step.label}
          </p>
          <p class="text-cdx-text-secondary text-sm leading-relaxed">{step.caption}</p>
          <div class="relative">
            <span
              aria-hidden="true"
              class="bg-cdx-bg-elevated text-cdx-text-muted absolute right-2 top-2 z-10 rounded px-1.5 py-0.5 font-mono text-[10px] tracking-wider uppercase"
            >
              {step.lang}
            </span>
            {/* prettier-ignore */}
            <pre class="bg-cdx-bg-alt/60 text-cdx-text overflow-x-auto rounded-lg p-3 pr-14 font-mono text-xs leading-relaxed"><code id={`gs-${step.id}-code`}>{step.code}</code></pre>
          </div>
          <button
            type="button"
            data-copy-target={`gs-${step.id}-code`}
            aria-label={`Copy ${step.label} command`}
            class="copy-btn group text-cdx-text-secondary hover:text-cdx-text hover:bg-cdx-bg-alt data-[copied=true]:text-cdx-primary mt-1 inline-flex w-fit items-center gap-1.5 rounded px-2 py-1 text-xs transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="copy-icon-default"
            >
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
            </svg>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="copy-icon-done"
            >
              <polyline points="20 6 9 17 4 12" />
            </svg>
            <span data-copy-label>Copy</span>
            <span class="sr-only" data-copy-live aria-live="polite" />
          </button>
        </div>
      ))
    }
  </div>
</section>
