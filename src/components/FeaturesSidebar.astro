---
import SectionEyebrow from './SectionEyebrow.astro';

interface Props {
  currentSlug?: string;
}

const { currentSlug } = Astro.props;
const base = import.meta.env.BASE_URL;

interface Guide {
  slug: string;
  number: number;
  title: string;
  blurb: string;
  related?: string[];
}

// Sidebar order follows the user journey:
// Overview → Setup → Daily use → Reference → Authoring →
// Advanced authoring → Customization → Hosting → CI → Tips.
// Numbers are contiguous 1..13 - renumber here and the byline,
// guides hub, and JSON-LD all pick it up automatically.
export const guides: Guide[] = [
  {
    slug: 'features',
    number: 1,
    title: 'Features',
    blurb:
      'Features, signals, dependency injection, multi-version, theming - the full output surface.',
    related: ['playground', 'themes', 'getting-started'],
  },
  {
    slug: 'getting-started',
    number: 2,
    title: 'Getting Started',
    blurb: 'Install, configure, and ship your first build in under a minute.',
    related: ['usage', 'options', 'themes'],
  },
  {
    slug: 'usage',
    number: 3,
    title: 'Usage',
    blurb: 'tsconfig pointing, watch mode, npm scripts, API diffs in CI.',
    related: ['options', 'tips', 'coverage'],
  },
  {
    slug: 'options',
    number: 4,
    title: 'Options',
    blurb: 'Every CLI flag and JSON config key, with defaults and gotchas.',
    related: ['usage', 'getting-started', 'routing'],
  },
  {
    slug: 'comments',
    number: 5,
    title: 'Comments',
    blurb: 'Markdown-flavored JSDoc that compodocx actually reads.',
    related: ['jsdoc-tags', 'playground', 'live-example'],
  },
  {
    slug: 'jsdoc-tags',
    number: 6,
    title: 'JSDoc Tags',
    blurb: '@param, @returns, @playground, @internal - supported tags and how each renders.',
    related: ['comments', 'playground', 'features'],
  },
  {
    slug: 'playground',
    number: 7,
    title: 'Playground Blocks',
    blurb:
      'Author-curated runnable demos via @playground - click-to-launch StackBlitz projects per component.',
    related: ['live-example', 'jsdoc-tags', 'comments'],
  },
  {
    slug: 'live-example',
    number: 8,
    title: 'Live Example Tab',
    blurb: 'Hosted demos shown in an iframe next to the API docs.',
    related: ['playground', 'comments', 'features'],
  },
  {
    slug: 'themes',
    number: 9,
    title: 'Themes',
    blurb: 'Eight bundled themes plus rolling your own via --color-cdx-* tokens.',
    related: ['options', 'features', 'tab-configuration'],
  },
  {
    slug: 'tab-configuration',
    number: 10,
    title: 'Tab Configuration',
    blurb: 'Reorder, relabel, or hide per-entity tabs and the sections inside them.',
    related: ['features', 'options', 'themes'],
  },
  {
    slug: 'routing',
    number: 11,
    title: 'Routing',
    blurb: 'The routes page, SPA navigation, and hash deep links.',
    related: ['options', 'tab-configuration'],
  },
  {
    slug: 'coverage',
    number: 12,
    title: 'Documentation Coverage',
    blurb: 'Per-symbol coverage, --coverageTest CI gating, --publicApiOnly scoping.',
    related: ['usage', 'options', 'tips'],
  },
  {
    slug: 'tips',
    number: 13,
    title: 'Tips and Tricks',
    blurb: 'Real-world patterns for monorepos, design systems, libraries.',
    related: ['usage', 'themes', 'options'],
  },
];
---

<aside class="border-cdx-border hidden self-stretch border-r pr-6 lg:block">
  <nav class="sticky top-20" aria-label="Guide navigation">
    <SectionEyebrow text="Guides" />
    <ol class="mt-4 space-y-0.5 text-sm">
      {
        guides.map((g) => {
          const active = g.slug === currentSlug;
          return (
            <li>
              <a
                href={`${base}guides/${g.slug}/`}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'flex gap-3 rounded px-3 py-2 transition-colors',
                  active
                    ? 'bg-cdx-bg-elevated text-cdx-text font-medium'
                    : 'text-cdx-text-secondary hover:bg-cdx-bg-alt hover:text-cdx-text',
                ]}
              >
                <span
                  class:list={[
                    'font-mono text-xs',
                    active ? 'text-cdx-text-secondary' : 'text-cdx-text-secondary',
                  ]}
                >
                  {String(g.number).padStart(2, '0')}
                </span>
                <span>{g.title}</span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </nav>
</aside>
