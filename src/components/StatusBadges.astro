---
async function fetchNpmVersion(): Promise<string | null> {
  try {
    const res = await fetch('https://registry.npmjs.org/@cngxjs/compodocx/latest', {
      headers: { Accept: 'application/json' },
    });
    if (!res.ok) return null;
    const data = (await res.json()) as { version?: string };
    return data.version ?? null;
  } catch {
    return null;
  }
}

const version = await fetchNpmVersion();
const repoUrl = 'https://github.com/cngxjs/compodocx';
const pkgUrl = 'https://www.npmjs.com/package/@cngxjs/compodocx';
---

<section class="bg-cdx-bg-alt/30 border-cdx-border border-y" aria-label="Project status">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-3 px-4 py-5">
    <a
      href={pkgUrl}
      rel="noopener"
      target="_blank"
      aria-label={`npm package version ${version ?? 'latest'} (opens in new tab)`}
      class="bg-cdx-bg-elevated text-cdx-text-secondary hover:text-cdx-text inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-medium"
    >
      <span class="text-cdx-text-muted" aria-hidden="true">npm</span>
      <span class="text-cdx-text font-mono" aria-hidden="true">
        {version ? `v${version}` : 'latest'}
      </span>
    </a>
    <span
      aria-label="Node.js version 22 or higher required"
      class="bg-cdx-bg-elevated text-cdx-text-secondary inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-medium"
    >
      <span class="text-cdx-text-muted" aria-hidden="true">node</span>
      <span class="text-cdx-text font-mono" aria-hidden="true">≥ 22</span>
    </span>
    <a
      href={`${repoUrl}/blob/develop/LICENSE`}
      rel="noopener"
      target="_blank"
      aria-label="MIT license (opens in new tab)"
      class="bg-cdx-bg-elevated text-cdx-text-secondary hover:text-cdx-text inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-medium"
    >
      <span class="text-cdx-text-muted" aria-hidden="true">license</span>
      <span class="text-cdx-text" aria-hidden="true">MIT</span>
    </a>
  </div>
</section>
