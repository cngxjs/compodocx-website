---
import { Image, getImage } from 'astro:assets';
import SectionEyebrow from './SectionEyebrow.astro';
import lqipMap from '../assets/screenshots/lqip.json';

import componentInfoLight from '../assets/screenshots/component-info-light.png';
import componentInfoDark from '../assets/screenshots/component-info-dark.png';
import componentApiLight from '../assets/screenshots/component-api-light.png';
import componentApiDark from '../assets/screenshots/component-api-dark.png';
import projectGraphLight from '../assets/screenshots/project-graph-light.png';
import projectGraphDark from '../assets/screenshots/project-graph-dark.png';
import sourceViewerLight from '../assets/screenshots/source-viewer-light.png';
import sourceViewerDark from '../assets/screenshots/source-viewer-dark.png';

interface Shot {
  id: string;
  label: string;
  caption: string;
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
}

const shots: Shot[] = [
  {
    id: 'component-info',
    label: 'Component Page',
    caption:
      'Every standalone component, directive, and pipe gets its own page with imports, providers, and member cards.',
    light: componentInfoLight,
    dark: componentInfoDark,
    alt: 'Generated compodocx component page showing imports, description, and an example block',
  },
  {
    id: 'component-api',
    label: 'API Surface',
    caption:
      'Inputs, outputs, signals, computed, and linked-signal members - every modern Angular surface as a flat, scannable list.',
    light: componentApiLight,
    dark: componentApiDark,
    alt: 'API tab with grouped index of properties, methods, inputs, outputs, derived state, host bindings, and accessors',
  },
  {
    id: 'project-graph',
    label: 'Dependency Graph',
    caption:
      'Interactive graph showing how your project connects - clickable nodes, deep-linked panels, smooth zoom.',
    light: projectGraphLight,
    dark: projectGraphDark,
    alt: 'Project overview page with an interactive force-directed dependency graph of components, directives, pipes, modules, and injectables',
  },
  {
    id: 'source-viewer',
    label: 'Source Viewer',
    caption:
      'Shiki syntax highlighting with a VSCode-style sticky source scope - the surrounding class and method stay pinned as you scroll.',
    light: sourceViewerLight,
    dark: sourceViewerDark,
    alt: 'Source viewer showing the signal-card component file with line numbers, syntax highlighting, and a sticky stack of the enclosing class and method',
  },
];

const enrichedShots = await Promise.all(
  shots.map(async (s) => ({
    ...s,
    fullLight: (await getImage({ src: s.light, width: 2048, format: 'avif', quality: 80 })).src,
    fullDark: (await getImage({ src: s.dark, width: 2048, format: 'avif', quality: 80 })).src,
    lqipLight: (lqipMap as Record<string, string>)[`${s.id}-light`],
    lqipDark: (lqipMap as Record<string, string>)[`${s.id}-dark`],
  })),
);
---

<section
  id="screenshots"
  class="mx-auto max-w-6xl px-4 py-24"
  aria-labelledby="screenshots-heading"
>
  <hgroup>
    <SectionEyebrow text="Output" />
    <h2 id="screenshots-heading" class="text-cdx-text mt-3 text-3xl font-semibold tracking-tight">
      What your users actually see
    </h2>
  </hgroup>
  <p class="text-cdx-text-secondary mt-3 max-w-2xl leading-relaxed">
    A static site where every standalone component, directive, and pipe gets a dedicated page. Deep
    links, full-text search, and a sticky source viewer included.
  </p>

  <div class="mt-12" data-tabs>
    <div
      role="tablist"
      aria-label="Screenshots"
      class="border-cdx-border flex flex-wrap gap-1 border-b"
    >
      {
        enrichedShots.map((shot, index) => (
          <button
            type="button"
            role="tab"
            id={`tab-${shot.id}`}
            aria-controls={`panel-${shot.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
            class="text-cdx-text-secondary aria-selected:text-cdx-text aria-selected:border-cdx-primary -mb-px cursor-pointer border-b-2 border-transparent px-4 py-3 text-sm font-medium transition-colors"
          >
            {shot.label}
          </button>
        ))
      }
    </div>

    {
      enrichedShots.map((shot, index) => (
        <div
          role="tabpanel"
          id={`panel-${shot.id}`}
          aria-labelledby={`tab-${shot.id}`}
          hidden={index !== 0}
          class="mt-6"
        >
          <figure>
            <button
              type="button"
              class="screenshot-zoom group bg-cdx-bg-elevated relative block aspect-[16/10] w-full cursor-zoom-in overflow-hidden rounded-xl"
              data-zoom-light={shot.fullLight}
              data-zoom-dark={shot.fullDark}
              data-zoom-alt={shot.alt}
              style={`--lqip-light:url('${shot.lqipLight}'); --lqip-dark:url('${shot.lqipDark}');`}
              aria-label={`View ${shot.label} screenshot at full resolution`}
            >
              <Image
                src={shot.light}
                alt={shot.alt}
                class="absolute inset-0 size-full object-cover dark:hidden"
                loading={index === 0 ? 'eager' : 'lazy'}
                widths={[640, 960, 1280]}
                sizes="(min-width: 1024px) 1024px, 100vw"
              />
              <Image
                src={shot.dark}
                alt={shot.alt}
                class="absolute inset-0 hidden size-full object-cover dark:block"
                loading={index === 0 ? 'eager' : 'lazy'}
                widths={[640, 960, 1280]}
                sizes="(min-width: 1024px) 1024px, 100vw"
              />
              <span
                aria-hidden="true"
                class="bg-cdx-bg-elevated/90 text-cdx-text-secondary absolute right-3 top-3 inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium opacity-0 backdrop-blur transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="11" cy="11" r="8" />
                  <path d="m21 21-4.3-4.3" />
                  <path d="M11 8v6" />
                  <path d="M8 11h6" />
                </svg>
                Click to zoom
              </span>
            </button>
            <figcaption class="text-cdx-text-secondary mt-3 text-sm">{shot.caption}</figcaption>
          </figure>
        </div>
      ))
    }
  </div>
</section>

<script>
  import { initTabs } from '../scripts/tabs';
  document.addEventListener('astro:page-load', () => initTabs());
</script>
