---
import { Image, getImage } from 'astro:assets';
import SectionEyebrow from './SectionEyebrow.astro';
import lqipMap from '../assets/screenshots/lqip.json';

import coverageLight from '../assets/screenshots/coverage-report-light.png';
import coverageDark from '../assets/screenshots/coverage-report-dark.png';

const altText =
  'Documentation coverage page with a donut chart, totals, and a sortable list of components by coverage percentage';

const fullLight = (await getImage({ src: coverageLight, width: 2048, format: 'avif', quality: 80 }))
  .src;
const fullDark = (await getImage({ src: coverageDark, width: 2048, format: 'avif', quality: 80 }))
  .src;
const lqip = lqipMap as Record<string, string>;
---

<section class="mx-auto max-w-6xl px-4 py-24" aria-labelledby="coverage-heading">
  <div class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
    <div>
      <hgroup>
        <SectionEyebrow text="Coverage" />
        <h2 id="coverage-heading" class="text-cdx-text mt-3 text-3xl font-semibold tracking-tight">
          Catch the undocumented bits before merge
        </h2>
      </hgroup>
      <p class="text-cdx-text-secondary mt-4 leading-relaxed">
        Per-symbol coverage rolls up into a sortable report. Documented vs. not, broken down by
        kind. Set
        <a
          href={`${import.meta.env.BASE_URL}guides/coverage/`}
          class="text-cdx-primary underline underline-offset-2"
          ><code class="cdx-code">--coverageMinimum</code></a
        > and your build fails below threshold.
      </p>
      <ul class="text-cdx-text-secondary mt-8 space-y-5 text-sm">
        <li class="flex gap-3.5">
          <span
            class="bg-cdx-primary/10 text-cdx-primary mt-0.5 inline-flex size-7 shrink-0 items-center justify-center rounded-md"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m3 17 2 2 4-4"></path>
              <path d="m3 7 2 2 4-4"></path>
              <path d="M13 6h8"></path>
              <path d="M13 12h8"></path>
              <path d="M13 18h8"></path>
            </svg>
          </span>
          <span class="leading-relaxed">
            <span class="text-cdx-text font-semibold">Deep-linked symbol list.</span>
            Click any undocumented item to jump straight into source.
          </span>
        </li>
        <li class="flex gap-3.5">
          <span
            class="bg-cdx-primary/10 text-cdx-primary mt-0.5 inline-flex size-7 shrink-0 items-center justify-center rounded-md"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="m12.83 2.18-9.55 4.78a2 2 0 0 0 0 3.58L12.83 15a2 2 0 0 0 1.66 0l9.55-4.46a2 2 0 0 0 0-3.58L14.49 2.18a2 2 0 0 0-1.66 0z"
              ></path>
              <path d="M2 12.5 12.83 17a2 2 0 0 0 1.66 0L22 12.5"></path>
              <path d="M2 17.5 12.83 22a2 2 0 0 0 1.66 0L22 17.5"></path>
            </svg>
          </span>
          <span class="leading-relaxed">
            <span class="text-cdx-text font-semibold">Breakdown by kind.</span>
            Components, directives, pipes, classes, interfaces - each tracked separately.
          </span>
        </li>
        <li class="flex gap-3.5">
          <span
            class="bg-cdx-primary/10 text-cdx-primary mt-0.5 inline-flex size-7 shrink-0 items-center justify-center rounded-md"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
            </svg>
          </span>
          <span class="leading-relaxed">
            <span class="text-cdx-text font-semibold">
              <code class="cdx-code">--publicApiOnly</code> filter.
            </span>
            Scope to your exported allow-list so internal helpers don&rsquo;t tank the percentage.
          </span>
        </li>
      </ul>
    </div>

    <figure>
      <button
        type="button"
        class="screenshot-zoom group bg-cdx-bg-elevated relative block aspect-[16/10] w-full cursor-zoom-in overflow-hidden rounded-xl"
        data-zoom-light={fullLight}
        data-zoom-dark={fullDark}
        data-zoom-alt={altText}
        style={`--lqip-light:url('${lqip['coverage-report-light']}'); --lqip-dark:url('${lqip['coverage-report-dark']}');`}
        aria-label="View documentation coverage screenshot at full resolution"
      >
        <Image
          src={coverageLight}
          alt={altText}
          class="absolute inset-0 size-full object-cover dark:hidden"
          loading="lazy"
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 512px, 100vw"
        />
        <Image
          src={coverageDark}
          alt={altText}
          class="absolute inset-0 hidden size-full object-cover dark:block"
          loading="lazy"
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 512px, 100vw"
        />
        <span
          aria-hidden="true"
          class="bg-cdx-bg-elevated/90 text-cdx-text-secondary absolute right-3 top-3 inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium opacity-0 backdrop-blur transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
            <path d="M11 8v6"></path>
            <path d="M8 11h6"></path>
          </svg>
          Click to zoom
        </span>
      </button>
    </figure>
  </div>
</section>
