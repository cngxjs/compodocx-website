---
const installCmd = 'npm install -D @cngxjs/compodocx';
---

<section class="hero-section relative isolate overflow-hidden">
  <div
    class="from-cdx-bg-alt/60 to-cdx-bg pointer-events-none absolute inset-0 -z-30 bg-gradient-to-b"
    aria-hidden="true"
  >
  </div>

  <div class="hero-orbs pointer-events-none absolute inset-0 -z-20" aria-hidden="true">
    <span class="orb orb-1"></span>
    <span class="orb orb-2"></span>
  </div>

  <div class="hero-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="mx-auto max-w-6xl px-4 py-24 sm:py-32">
    <hgroup class="relative isolate">
      <p class="text-cdx-text-secondary text-xs font-semibold tracking-[0.25em] uppercase">
        Angular · Open source · Node 22+
      </p>
      <h1
        class="hero-headline text-cdx-text mt-4 max-w-4xl text-4xl font-semibold tracking-tight sm:text-5xl lg:text-7xl"
      >
        Static Angular docs.<br class="hidden sm:block" /> Every release.
      </h1>
    </hgroup>
    <p class="text-cdx-text-secondary mt-6 max-w-2xl text-lg leading-relaxed sm:text-xl">
      compodocx turns your Angular source into a documentation site &mdash;
      <span class="text-ember font-medium">standalone, signal-aware, themable</span>.<br />
      Multi-version output, CI diffs, and LLM-context export included.
    </p>
    <p class="text-cdx-text mt-3 max-w-2xl text-lg font-semibold sm:text-xl">All from one CLI.</p>
    <div class="mt-10 flex flex-col items-stretch gap-3 sm:flex-row">
      <div
        class="bg-cdx-bg-elevated inline-flex h-12 items-center gap-3 rounded-lg px-4 font-mono text-sm"
      >
        <span class="text-cdx-primary font-semibold select-none" aria-hidden="true">$</span>
        <code id="hero-install-cmd" class="text-cdx-text whitespace-nowrap">{installCmd}</code>
        <button
          type="button"
          data-copy-target="hero-install-cmd"
          aria-label="Copy install command"
          class="copy-btn group text-cdx-text-secondary hover:text-cdx-text hover:bg-cdx-bg-alt data-[copied=true]:text-cdx-primary ml-2 inline-flex items-center gap-1.5 rounded px-2 py-1 text-xs transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="copy-icon-default"
          >
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
          </svg>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="copy-icon-done"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span data-copy-label>Copy</span>
          <span class="sr-only" data-copy-live aria-live="polite"></span>
        </button>
      </div>
      <a
        href="#screenshots"
        class="bg-cdx-primary text-cdx-text-inverse hover:bg-cdx-primary-hover group inline-flex h-12 items-center justify-center gap-2 rounded-lg px-6 text-sm font-medium transition-colors"
      >
        See it in action
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero-section .orb {
    position: absolute;
    will-change: transform;
  }

  .hero-section .orb-1 {
    inline-size: 50rem;
    block-size: 50rem;
    inset-block-start: -16rem;
    inset-inline-start: -16rem;
    background: radial-gradient(closest-side, var(--color-cdx-primary) 0%, transparent 65%);
    opacity: 0.18;
    animation: hero-drift-1 24s ease-in-out infinite;
  }

  .hero-section .orb-2 {
    inline-size: 45rem;
    block-size: 45rem;
    inset-block-start: -8rem;
    inset-inline-end: -16rem;
    background: radial-gradient(closest-side, var(--color-cdx-primary-subtle) 0%, transparent 65%);
    opacity: 0.45;
    animation: hero-drift-2 28s ease-in-out infinite;
  }

  .hero-section .hero-headline {
    padding-block-end: 0.12em;
    line-height: 1.15;
    background-color: var(--color-cdx-text);
    background-image: linear-gradient(
      100deg,
      transparent 0%,
      transparent 42%,
      hsl(35 100% 62% / 0.95) 48%,
      hsl(20 100% 65%) 50%,
      hsl(35 100% 62% / 0.95) 52%,
      transparent 58%,
      transparent 100%
    );
    background-size: 220% 100%;
    background-position: 100% 0;
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: hero-headline-shimmer 1.4s cubic-bezier(0.25, 0.1, 0.25, 1) 0.05s 1 forwards;
  }

  @keyframes hero-headline-shimmer {
    0% {
      background-position: 100% 0;
    }
    100% {
      background-position: 0% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-section .hero-headline {
      animation: none !important;
      background-position: 0 0 !important;
    }
  }

  .hero-section .hero-grid {
    background-image: radial-gradient(circle at 1px 1px, var(--color-cdx-text) 1px, transparent 0);
    background-size: 28px 28px;
    opacity: 0.08;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, #000 30%, transparent 80%);
  }

  @keyframes hero-drift-1 {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(120px, 60px, 0);
    }
  }

  @keyframes hero-drift-2 {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(-100px, 80px, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-section .orb {
      animation: none !important;
    }
  }
</style>

<script>
  import { initCopyButtons } from '../scripts/copy-button';
  document.addEventListener('astro:page-load', () => initCopyButtons());
</script>
