---
const base = import.meta.env.BASE_URL;
const repoUrl = 'https://github.com/cngxjs/compodocx';

const themes: Array<{ id: string; label: string }> = [
  { id: 'default', label: 'Slate Noir' },
  { id: 'ocean', label: 'Ocean' },
  { id: 'midnight', label: 'Midnight' },
  { id: 'nord', label: 'Nord' },
  { id: 'rose-pine', label: 'Rose Pine' },
  { id: 'ember', label: 'Ember' },
  { id: 'neon', label: 'Neon' },
  { id: 'brutalist', label: 'Brutalist' },
];
---

<header
  class="border-cdx-border bg-cdx-bg/85 supports-[backdrop-filter]:bg-cdx-bg/70 sticky top-0 z-40 border-b backdrop-blur"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href={base} class="text-cdx-text font-semibold tracking-tight" aria-label="compodocx home">
      compodoc<span class="text-ember font-bold">x</span>
    </a>

    <nav class="flex items-center gap-1 text-sm sm:gap-2">
      <a
        href={`${base}guides/`}
        class="text-cdx-text hover:bg-cdx-bg-alt hover:text-cdx-text inline-flex items-center gap-1.5 rounded px-2 py-1.5 sm:px-3"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="sm:hidden"
        >
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
        </svg>
        <span class="hidden sm:inline">Guides</span>
        <span class="sr-only sm:hidden">Guides</span>
      </a>
      <a
        href={repoUrl}
        rel="noopener"
        target="_blank"
        aria-label="GitHub repository (opens in new tab)"
        class="text-cdx-text hover:bg-cdx-bg-alt rounded p-2.5 sm:p-3"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.87-1.54-3.87-1.54-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.69 1.24 3.34.95.1-.74.4-1.24.72-1.53-2.55-.29-5.24-1.27-5.24-5.66 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.17a10.95 10.95 0 0 1 5.74 0c2.19-1.48 3.15-1.17 3.15-1.17.62 1.58.23 2.75.11 3.04.74.8 1.18 1.82 1.18 3.07 0 4.4-2.69 5.36-5.25 5.65.41.36.78 1.07.78 2.16 0 1.56-.01 2.82-.01 3.2 0 .31.21.67.8.55C20.22 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5Z"
          ></path>
        </svg>
      </a>

      <details id="theme-menu" class="relative">
        <summary
          class="text-cdx-text hover:bg-cdx-bg-alt flex cursor-pointer list-none items-center rounded p-2.5 sm:p-3"
          aria-label="Choose theme"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M12 22a10 10 0 1 1 10-10 4 4 0 0 1-4 4h-1.8a2 2 0 0 0-1.4 3.4l.4.4a2 2 0 0 1-1.4 3.4z"
            ></path>
            <circle cx="13.5" cy="6.5" r=".75" fill="currentColor" stroke="none"></circle>
            <circle cx="17.5" cy="10.5" r=".75" fill="currentColor" stroke="none"></circle>
            <circle cx="6.5" cy="12.5" r=".75" fill="currentColor" stroke="none"></circle>
            <circle cx="8.5" cy="7.5" r=".75" fill="currentColor" stroke="none"></circle>
          </svg>
        </summary>
        <div
          class="bg-cdx-bg-elevated border-cdx-border absolute right-0 top-full z-50 mt-1 w-48 rounded-lg border py-1 shadow-lg"
          role="menu"
        >
          {
            themes.map((t) => (
              <button
                type="button"
                role="menuitemradio"
                data-theme-id={t.id}
                aria-checked="false"
                class="text-cdx-text-secondary hover:text-cdx-text hover:bg-cdx-bg-alt aria-checked:text-cdx-text aria-checked:font-medium block w-full px-4 py-2 text-left text-sm"
              >
                {t.label}
              </button>
            ))
          }
        </div>
      </details>

      <button
        id="dark-toggle"
        type="button"
        aria-label="Toggle dark mode"
        aria-pressed="false"
        class="text-cdx-text hover:bg-cdx-bg-alt rounded p-2.5 sm:p-3"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="hidden dark:block"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="block dark:hidden"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  import { initDarkToggle } from '../scripts/dark-mode';
  import { initThemeSwitcher } from '../scripts/theme-switcher';

  function init(): void {
    initDarkToggle();
    initThemeSwitcher();

    const menu = document.getElementById('theme-menu') as HTMLDetailsElement | null;
    if (!menu || menu.dataset.menuBound === 'true') return;
    menu.dataset.menuBound = 'true';
    menu.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest('button[data-theme-id]')) {
        menu.open = false;
      }
    });
    document.addEventListener('click', (event) => {
      if (!menu.open) return;
      if (!menu.contains(event.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.open) return;
      menu.open = false;
      const summary = menu.querySelector('summary');
      if (summary instanceof HTMLElement) summary.focus();
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
