---
import SectionEyebrow from './SectionEyebrow.astro';

const base = import.meta.env.BASE_URL;

interface Feature {
  id: string;
  category: string;
  title: string;
  blurb: string;
  slug: string;
  iconPath: string;
  iconColor: string;
}

const features: Feature[] = [
  {
    id: 'standalone',
    category: 'Angular Support',
    title: 'Standalone-First Components',
    blurb:
      'Components, directives, and pipes documented as standalone artifacts — no NgModule wrapping, just the modern Angular surface.',
    slug: 'overview',
    iconColor: 'text-rose-500 dark:text-rose-400',
    iconPath:
      'M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z M3.27 6.96 12 12.01l8.73-5.05 M12 22.08V12',
  },
  {
    id: 'signals',
    category: 'Angular Support',
    title: 'Signals & Computed',
    blurb:
      'First-class support for signal, computed, and linked-signal members — with optional effect detection.',
    slug: 'overview',
    iconColor: 'text-sky-500 dark:text-sky-400',
    iconPath:
      'M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14Z',
  },
  {
    id: 'themes',
    category: 'Theming',
    title: '7 Premium Themes',
    blurb:
      'Slate Noir, Ocean, Midnight, Nord, Rose Pine, Ember, Neon, and Brutalist — switch with one CSS-variable swap.',
    slug: 'themes',
    iconColor: 'text-violet-500 dark:text-violet-400',
    iconPath:
      'M12 22a10 10 0 1 1 10-10 4 4 0 0 1-4 4h-1.8a2 2 0 0 0-1.4 3.4l.4.4a2 2 0 0 1-1.4 3.4Z M13.5 6.5a1 1 0 1 0 1 1 1 1 0 0 0-1-1Z M17.5 10.5a1 1 0 1 0 1 1 1 1 0 0 0-1-1Z M6.5 12.5a1 1 0 1 0 1 1 1 1 0 0 0-1-1Z M8.5 7.5a1 1 0 1 0 1 1 1 1 0 0 0-1-1Z',
  },
  {
    id: 'versions',
    category: 'Build & CI',
    title: 'Multi-Version Output',
    blurb:
      'Generate side-by-side docs for multiple library versions with an auto-detected versionLabel and a built-in switcher.',
    slug: 'usage',
    iconColor: 'text-emerald-500 dark:text-emerald-400',
    iconPath:
      'm12.83 2.18 8.42 4.21a2 2 0 0 1 0 3.58L12.83 14.18a2 2 0 0 1-1.66 0L2.75 9.97a2 2 0 0 1 0-3.58l8.42-4.21a2 2 0 0 1 1.66 0Z m9 12.05L13 18.45a2 2 0 0 1-2 0L2.05 14.23 m21.05 4.55L13 23a2 2 0 0 1-2 0l-9.05-4.22',
  },
  {
    id: 'cli',
    category: 'Tooling',
    title: 'Migration & Diff CLIs',
    blurb:
      'compodocx migrate ports Handlebars overrides to JSX templates. compodocx diff produces semver-aware API snapshots for CI.',
    slug: 'usage',
    iconColor: 'text-amber-500 dark:text-amber-400',
    iconPath:
      'M3 9h2 M3 15h2 M9 3v2 M15 3v2 M9 19v2 M15 19v2 M19 9h2 M19 15h2 M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z M9 11h6 M9 14h4',
  },
  {
    id: 'llm',
    category: 'Tooling',
    title: 'LLM-Context Export',
    blurb:
      'Export the entire docs surface as LLM-context markdown or typed JSON, ready for an agent or build pipeline.',
    slug: 'options',
    iconColor: 'text-fuchsia-500 dark:text-fuchsia-400',
    iconPath:
      'M12 8V4H8 m16 8v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6 M2 12h20 M9 16h.01 M15 16h.01 M6 12V8a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v4',
  },
];

function paths(d: string): string[] {
  return d.split(/\s(?=[Mm])/).filter(Boolean);
}
---

<section class="mx-auto max-w-6xl px-4 py-20" aria-labelledby="features-heading">
  <SectionEyebrow text="Features" />
  <h2 id="features-heading" class="text-cdx-text mt-3 text-3xl font-semibold tracking-tight">
    Built for modern Angular projects
  </h2>

  <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
    {
      features.map((feature) => (
        <article class="bg-cdx-bg-elevated group grid grid-rows-[auto_auto_auto_1fr_auto] rounded-xl p-6">
          <div class={`${feature.iconColor} inline-flex size-10 items-center justify-center`}>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              {paths(feature.iconPath).map((d) => (
                <path d={d} />
              ))}
            </svg>
          </div>
          <p class="text-cdx-text-muted mt-5 text-xs font-semibold tracking-[0.2em] uppercase">
            {feature.category}
          </p>
          <h3 class="text-cdx-text mt-2 text-lg font-semibold">{feature.title}</h3>
          <p class="text-cdx-text-secondary mt-2 text-sm leading-relaxed">{feature.blurb}</p>
          <a
            href={`${base}features/${feature.slug}/`}
            class="text-cdx-primary group-hover:text-cdx-primary-hover mt-6 inline-flex items-center gap-1 text-sm font-medium"
          >
            Learn more
            <span aria-hidden="true">→</span>
          </a>
        </article>
      ))
    }
  </div>
</section>
