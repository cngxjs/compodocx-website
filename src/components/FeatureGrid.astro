---
import SectionEyebrow from './SectionEyebrow.astro';

const base = import.meta.env.BASE_URL;

interface Feature {
  id: string;
  category: string;
  title: string;
  blurb: string;
  slug: string;
  hash?: string;
  cta: string;
  iconBody: string;
  iconColor: string;
}

const features: Feature[] = [
  {
    id: 'library-mode',
    category: 'Library mode',
    title: 'Curated chapter + reference portal',
    blurb:
      'Set <code class="cdx-code">menuLayout: \'feature\'</code> to ship a curated <strong>Features</strong> chapter highlighting the components, directives, and entry points readers land on first, plus an exhaustive <strong>References</strong> portal covering every public symbol. Default <code class="cdx-code">\'type\'</code> keeps the classic per-kind layout.',
    slug: 'features',
    hash: 'bifurcation',
    cta: 'Library mode walkthrough',
    iconColor: 'text-rose-500 dark:text-rose-400',
    iconBody: `<path d="M3 5h18"/><path d="M3 12h6"/><path d="M3 19h6"/><path d="M15 12h6"/><path d="M15 19h6"/>`,
  },
  {
    id: 'signals',
    category: 'Angular Support',
    title: 'Signals, properly rendered',
    blurb:
      '<code class="cdx-code">signal()</code>, <code class="cdx-code">computed()</code>, and <code class="cdx-code">linkedSignal()</code> render as first-class members with their derived dependencies. Effects opt in via JSDoc tag.',
    slug: 'features',
    cta: 'Signals deep dive',
    iconColor: 'text-sky-500 dark:text-sky-400',
    iconBody: `<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>`,
  },
  {
    id: 'themes',
    category: 'Theming',
    title: 'Eight themes, or your own',
    blurb:
      'Slate Noir, Ocean, Midnight, Nord, Rose Pine, Ember, Neon, Brutalist. Override any subset of <code class="cdx-code">--color-cdx-*</code> tokens to ship your brand.',
    slug: 'themes',
    cta: 'Theming guide',
    iconColor: 'text-violet-500 dark:text-violet-400',
    iconBody: `<path d="M12 22a10 10 0 1 1 10-10 4 4 0 0 1-4 4h-1.8a2 2 0 0 0-1.4 3.4l.4.4a2 2 0 0 1-1.4 3.4z"/><circle cx="13.5" cy="6.5" r=".75" fill="currentColor" stroke="none"/><circle cx="17.5" cy="10.5" r=".75" fill="currentColor" stroke="none"/><circle cx="6.5" cy="12.5" r=".75" fill="currentColor" stroke="none"/><circle cx="8.5" cy="7.5" r=".75" fill="currentColor" stroke="none"/>`,
  },
  {
    id: 'versions',
    category: 'Build & CI',
    title: 'Side-by-side versions',
    blurb:
      'Docs for every release on one domain. Labels auto-detected from <code class="cdx-code">package.json</code>. The version-switcher widget ships built in.',
    slug: 'usage',
    cta: 'Multi-version setup',
    iconColor: 'text-emerald-500 dark:text-emerald-400',
    iconBody: `<path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"/><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"/><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"/>`,
  },
  {
    id: 'cli',
    category: 'Tooling',
    title: 'Migrate & diff sub-CLIs',
    blurb:
      '<code class="cdx-code">compodocx migrate</code> rewrites your old Handlebars templates as JS partials. <code class="cdx-code">compodocx diff</code> fails CI when your public API changes.',
    slug: 'usage',
    cta: 'CLI reference',
    iconColor: 'text-amber-500 dark:text-amber-400',
    iconBody: `<path d="m7 11 2-2-2-2"/><path d="M11 13h4"/><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>`,
  },
  {
    id: 'llm',
    category: 'Tooling',
    title: 'LLM-ready export',
    blurb:
      'Export your API as flat markdown or typed JSON. Drop it into Claude, Copilot, your code-review bot - or any downstream pipeline.',
    slug: 'options',
    cta: 'Export options',
    iconColor: 'text-fuchsia-500 dark:text-fuchsia-400',
    iconBody: `<path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>`,
  },
];
---

<section class="mx-auto max-w-6xl px-4 py-24" aria-labelledby="features-heading">
  <hgroup>
    <SectionEyebrow text="Features" />
    <h2 id="features-heading" class="text-cdx-text mt-3 text-3xl font-semibold tracking-tight">
      Built for modern Angular projects
    </h2>
  </hgroup>

  <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
    {
      features.map((feature) => (
        <article class="bg-cdx-bg-elevated group grid grid-rows-[auto_auto_auto_1fr_auto] rounded-xl p-6">
          <div class={`${feature.iconColor} inline-flex size-10 items-center justify-center`}>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={feature.iconBody}
            />
          </div>
          <p class="text-cdx-text-secondary mt-5 text-xs font-semibold tracking-[0.2em] uppercase">
            {feature.category}
          </p>
          <h3 class="text-cdx-text mt-2 text-lg font-semibold">{feature.title}</h3>
          <p
            class="text-cdx-text-secondary mt-2 text-sm leading-relaxed"
            set:html={feature.blurb}
          />

          <a
            href={`${base}guides/${feature.slug}/${feature.hash ? `#${feature.hash}` : ''}`}
            aria-label={`${feature.cta} - ${feature.title}`}
            class="text-cdx-primary group-hover:text-cdx-primary-hover mt-6 inline-flex items-center gap-1 text-sm font-medium"
          >
            {feature.cta}
            <span aria-hidden="true">→</span>
          </a>
        </article>
      ))
    }
  </div>
</section>
