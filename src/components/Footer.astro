---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
const repoUrl = 'https://github.com/cngxjs/compodocx';
const pkgUrl = 'https://www.npmjs.com/package/@cngxjs/compodocx';

interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
}

interface FooterColumn {
  heading: string;
  links: FooterLink[];
}

const columns: FooterColumn[] = [
  {
    heading: 'Product',
    links: [
      { label: 'Guides', href: `${base}guides/` },
      { label: 'Themes', href: `${base}#themes` },
      {
        label: 'Migration guide',
        href: `${repoUrl}/blob/develop/MIGRATION.md`,
        external: true,
      },
    ],
  },
  {
    heading: 'Resources',
    links: [
      { label: 'npm package', href: pkgUrl, external: true },
      { label: 'GitHub', href: repoUrl, external: true },
      { label: 'Issues', href: `${repoUrl}/issues`, external: true },
      { label: 'Discussions', href: `${repoUrl}/discussions`, external: true },
    ],
  },
  {
    heading: 'Project',
    links: [
      { label: 'Changelog', href: `${repoUrl}/releases`, external: true },
      { label: 'MIT License', href: `${repoUrl}/blob/develop/LICENSE`, external: true },
      {
        label: 'Contributing',
        href: `${repoUrl}/blob/develop/CONTRIBUTING.md`,
        external: true,
      },
    ],
  },
];
---

<footer
  class="border-cdx-border bg-cdx-bg-alt/40 text-cdx-text-secondary mt-24 border-t py-12 text-sm"
>
  <div class="mx-auto max-w-6xl px-4">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <div>
        <p class="text-cdx-text text-base font-semibold tracking-tight">compodocx</p>
        <p class="mt-3 max-w-xs text-xs leading-relaxed">
          Static Angular docs, every release. Open source under MIT, runs on Node 22+.
        </p>
        <p class="text-cdx-text-secondary mt-4 text-xs leading-relaxed">
          Fork of
          <a
            href="https://github.com/compodoc/compodoc"
            rel="noopener"
            target="_blank"
            class="hover:text-cdx-text underline-offset-2 hover:underline"
          >
            compodoc<span class="sr-only"> (opens in new tab)</span>
          </a>
          by Vincent Ogloblinsky.
        </p>
      </div>

      {
        columns.map((col) => (
          <div>
            <p class="text-cdx-text text-xs font-semibold tracking-[0.2em] uppercase">
              {col.heading}
            </p>
            <ul class="mt-4 space-y-2.5">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    rel={link.external ? 'noopener' : undefined}
                    target={link.external ? '_blank' : undefined}
                    class="hover:text-cdx-text inline-flex items-center gap-1 transition-colors"
                  >
                    {link.label}
                    {link.external && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="11"
                        height="11"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                        class="opacity-50"
                      >
                        <path d="M7 7h10v10" />
                        <path d="M7 17 17 7" />
                      </svg>
                    )}
                    {link.external && <span class="sr-only">(opens in new tab)</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="border-cdx-border mt-10 flex flex-col gap-2 border-t pt-6 text-xs sm:flex-row sm:justify-between"
    >
      <p>© {year} cngxjs</p>
      <p class="text-cdx-text-secondary">Built with Astro · Deployed on GitHub Pages</p>
    </div>
  </div>
</footer>
