---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import oceanCss from '../styles/vendor/compodocx/themes/ocean.css?raw';
import midnightCss from '../styles/vendor/compodocx/themes/midnight.css?raw';
import nordCss from '../styles/vendor/compodocx/themes/nord.css?raw';
import rosePineCss from '../styles/vendor/compodocx/themes/rose-pine.css?raw';
import emberCss from '../styles/vendor/compodocx/themes/ember.css?raw';
import neonCss from '../styles/vendor/compodocx/themes/neon.css?raw';
import brutalistCss from '../styles/vendor/compodocx/themes/brutalist.css?raw';

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  keywords?: string[];
  jsonLd?: object | object[];
  prevUrl?: string;
  nextUrl?: string;
}

const {
  title,
  description,
  image,
  ogType = 'website',
  keywords,
  jsonLd,
  prevUrl,
  nextUrl,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const siteUrl = Astro.site ?? new URL(base, 'https://cngxjs.github.io');
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const homeUrl = new URL(base, siteUrl).href;
const ogImage = new URL(image ?? `${base}og-image.png`, siteUrl).href;
const fallbackDescription =
  'Modern documentation tool for Angular applications. Fork of compodoc, modernized: standalone-first, Signals, theming tokens, multi-version, migration tools.';
const metaDescription = description ?? fallbackDescription;
const defaultKeywords = [
  'angular documentation',
  'compodocx',
  'compodoc',
  'angular standalone',
  'angular signals',
  'jsdoc angular',
  'typescript documentation',
  'static documentation generator',
  'angular cli docs',
  'multi-version docs',
];
const metaKeywords = (keywords ?? defaultKeywords).join(', ');

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${homeUrl}#organization`,
  name: 'cngxjs',
  url: 'https://github.com/cngxjs',
  logo: {
    '@type': 'ImageObject',
    url: ogImage,
    width: 1200,
    height: 630,
  },
  sameAs: [
    'https://github.com/cngxjs',
    'https://github.com/cngxjs/compodocx',
    'https://www.npmjs.com/package/@cngxjs/compodocx',
  ],
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${homeUrl}#website`,
  name: 'compodocx',
  url: homeUrl,
  description: fallbackDescription,
  inLanguage: 'en',
  publisher: { '@id': `${homeUrl}#organization` },
  potentialAction: {
    '@type': 'ReadAction',
    target: homeUrl,
  },
};

const jsonLdEntries = (Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []).concat([
  websiteJsonLd,
  organizationJsonLd,
]);

function scopeTheme(css: string, themeId: string): string {
  const stripped = css.replace(/\/\*[\s\S]*?\*\//g, '');
  const rootMatch = stripped.match(/:root\s*\{([^{}]*)\}/);
  const darkMatch = stripped.match(/(?:^|[^a-zA-Z0-9_-])\.dark\s*\{([^{}]*)\}/);
  let out = '';
  if (rootMatch) {
    out += `:root[data-theme="${themeId}"] {${rootMatch[1]}}`;
  }
  if (darkMatch) {
    out += `:root[data-theme="${themeId}"].dark {${darkMatch[1]}}`;
  }
  return out;
}

function minifyCss(css: string): string {
  return css
    .replace(/\s+/g, ' ')
    .replace(/\s*([{}:;,>+~])\s*/g, '$1')
    .replace(/;}/g, '}')
    .trim();
}

const themeBundle = minifyCss(
  (
    [
      ['ocean', oceanCss],
      ['midnight', midnightCss],
      ['nord', nordCss],
      ['rose-pine', rosePineCss],
      ['ember', emberCss],
      ['neon', neonCss],
      ['brutalist', brutalistCss],
    ] as const
  )
    .map(([id, css]) => scopeTheme(css, id))
    .join('\n'),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="cngxjs" />
    <meta name="publisher" content="cngxjs" />
    <meta name="copyright" content={`© ${new Date().getFullYear()} cngxjs`} />
    <meta name="keywords" content={metaKeywords} />
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
    <meta name="googlebot" content="index, follow" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="canonical" href={canonical} />
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
    <link
      rel="alternate"
      type="application/xml"
      title="Sitemap"
      href={`${base}sitemap-index.xml`}
    />
    <link rel="dns-prefetch" href="https://github.com" />
    <link rel="dns-prefetch" href="https://www.npmjs.com" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="compodocx" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — compodocx`} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${title} — compodocx`} />

    <meta name="theme-color" content="#f5f5f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1c1c" media="(prefers-color-scheme: dark)" />

    {
      jsonLdEntries.map((entry) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(entry)} />
      ))
    }

    <ClientRouter />
    <style is:global set:html={themeBundle}></style>
    <script is:inline>
      (function () {
        function apply(doc) {
          try {
            const stored = localStorage.getItem('compodocx-website-darkmode');
            const dark =
              stored === null
                ? window.matchMedia('(prefers-color-scheme: dark)').matches
                : stored === 'true';
            doc.documentElement.classList.toggle('dark', dark);
          } catch (_) {
            // storage / matchMedia unavailable — fall through to light default
          }
          try {
            const theme = localStorage.getItem('compodocx-website-theme');
            if (theme && theme !== 'default') {
              doc.documentElement.setAttribute('data-theme', theme);
            } else {
              doc.documentElement.removeAttribute('data-theme');
            }
          } catch (_) {
            // ignore — fall through to default theme
          }
        }

        apply(document);

        if (!window.__compodocxThemeHook) {
          window.__compodocxThemeHook = true;
          document.addEventListener('astro:before-swap', (event) => {
            apply(event.newDocument);
          });
        }
      })();
    </script>
  </head>
  <body class="bg-cdx-bg text-cdx-text grid min-h-screen grid-rows-[auto_1fr_auto] antialiased">
    <a
      href="#main"
      class="bg-cdx-bg-elevated text-cdx-text border-cdx-border sr-only rounded border px-3 py-2 focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50"
    >
      Skip to content
    </a>
    <NavBar />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
