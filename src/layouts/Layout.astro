---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import oceanCss from '../styles/vendor/compodocx/themes/ocean.css?raw';
import midnightCss from '../styles/vendor/compodocx/themes/midnight.css?raw';
import nordCss from '../styles/vendor/compodocx/themes/nord.css?raw';
import rosePineCss from '../styles/vendor/compodocx/themes/rose-pine.css?raw';
import emberCss from '../styles/vendor/compodocx/themes/ember.css?raw';
import neonCss from '../styles/vendor/compodocx/themes/neon.css?raw';
import brutalistCss from '../styles/vendor/compodocx/themes/brutalist.css?raw';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;

function scopeTheme(css: string, themeId: string): string {
  return css
    .replace(/\/\*[\s\S]*?\*\//g, '')
    .replace(/:root\s*\{/g, `:root[data-theme="${themeId}"] {`)
    .replace(/\.dark\s*\{/g, `:root[data-theme="${themeId}"].dark {`)
    .replace(/(^|\})\s*\.dark\s+([^{}]+)\s*\{/g, (_match, lead, sel) => {
      const trimmed = String(sel).trim();
      return `${lead} :root[data-theme="${themeId}"].dark ${trimmed} {`;
    });
}

function minifyCss(css: string): string {
  return css
    .replace(/\s+/g, ' ')
    .replace(/\s*([{}:;,>+~])\s*/g, '$1')
    .replace(/;}/g, '}')
    .trim();
}

const themeBundle = minifyCss(
  (
    [
      ['ocean', oceanCss],
      ['midnight', midnightCss],
      ['nord', nordCss],
      ['rose-pine', rosePineCss],
      ['ember', emberCss],
      ['neon', neonCss],
      ['brutalist', brutalistCss],
    ] as const
  )
    .map(([id, css]) => scopeTheme(css, id))
    .join('\n'),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <style is:global set:html={themeBundle}></style>
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('compodocx-website-darkmode');
          const dark =
            stored === null
              ? window.matchMedia('(prefers-color-scheme: dark)').matches
              : stored === 'true';
          if (dark) document.documentElement.classList.add('dark');
        } catch (_) {
          // storage / matchMedia unavailable — fall through to light default
        }
        try {
          const theme = localStorage.getItem('compodocx-website-theme');
          if (theme && theme !== 'default') {
            document.documentElement.setAttribute('data-theme', theme);
          }
        } catch (_) {
          // ignore — fall through to default theme
        }
      })();
    </script>
  </head>
  <body class="bg-cdx-bg text-cdx-text grid min-h-screen grid-rows-[auto_1fr_auto] antialiased">
    <a
      href="#main"
      class="bg-cdx-bg-elevated text-cdx-text border-cdx-border sr-only rounded border px-3 py-2 focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50"
    >
      Skip to content
    </a>
    <NavBar />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
