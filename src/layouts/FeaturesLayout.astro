---
import Layout from './Layout.astro';
import FeaturesSidebar, { guides } from '../components/FeaturesSidebar.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';

interface Props {
  currentSlug: string;
  title: string;
  description?: string;
  extraJsonLd?: object | object[];
}

const { currentSlug, title, description, extraJsonLd } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteUrl = Astro.site ?? new URL(base, 'https://cngxjs.github.io');
const canonical = new URL(Astro.url.pathname, siteUrl).href;

const index = guides.findIndex((g) => g.slug === currentSlug);
const guide = guides[index];
const prev = index > 0 ? guides[index - 1] : null;
const next = index >= 0 && index < guides.length - 1 ? guides[index + 1] : null;

if (!guide) {
  throw new Error(`unknown guide slug: ${currentSlug}`);
}

const relatedGuides = (guide.related ?? [])
  .map((slug) => guides.find((g) => g.slug === slug))
  .filter((g): g is (typeof guides)[number] => Boolean(g));

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: guide.title,
  description,
  url: canonical,
  mainEntityOfPage: canonical,
  inLanguage: 'en',
  proficiencyLevel: 'Intermediate',
  dependencies: '@cngxjs/compodocx, Node.js >= 22, TypeScript',
  isPartOf: { '@id': `${new URL(base, siteUrl).href}#website` },
  publisher: { '@id': `${new URL(base, siteUrl).href}#organization` },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['article > header h1', 'article > div > p:first-of-type'],
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL(base, siteUrl).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Guides',
      item: new URL(`${base}guides/`, siteUrl).href,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: guide.title,
      item: canonical,
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  jsonLd={[
    articleJsonLd,
    breadcrumbJsonLd,
    ...(Array.isArray(extraJsonLd) ? extraJsonLd : extraJsonLd ? [extraJsonLd] : []),
  ]}
  prevUrl={prev ? new URL(`${base}guides/${prev.slug}/`, siteUrl).href : undefined}
  nextUrl={next ? new URL(`${base}guides/${next.slug}/`, siteUrl).href : undefined}
>
  <div class="mx-auto max-w-6xl px-4 py-16 lg:grid lg:grid-cols-[14rem_1fr] lg:gap-10">
    <FeaturesSidebar currentSlug={currentSlug} />

    <article class="mx-auto max-w-3xl">
      <header>
        <SectionEyebrow text={`Guide ${String(guide.number).padStart(2, '0')}`} />
        <h1 class="text-cdx-text mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
          {guide.title}
        </h1>
      </header>

      <div class="mt-10 space-y-6">
        <slot />
      </div>

      {
        relatedGuides.length > 0 && (
          <aside
            class="border-cdx-border mt-20 border-t pt-8"
            aria-labelledby={`related-${guide.slug}`}
          >
            <h2
              id={`related-${guide.slug}`}
              class="text-cdx-text-muted text-xs font-semibold uppercase tracking-[0.2em]"
            >
              Related guides
            </h2>
            <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {relatedGuides.map((r) => (
                <li>
                  <a
                    href={`${base}guides/${r.slug}/`}
                    class="bg-cdx-bg-elevated hover:bg-cdx-bg-alt group block rounded-lg p-4 transition-colors"
                  >
                    <span class="text-cdx-text-muted font-mono text-xs">
                      {String(r.number).padStart(2, '0')}
                    </span>
                    <span class="text-cdx-text mt-1 block text-sm font-semibold">{r.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }

      <nav
        class="border-cdx-border mt-12 flex items-center justify-between gap-4 border-t pt-8 text-sm"
        aria-label="Guide pagination"
      >
        {
          prev ? (
            <a
              href={`${base}guides/${prev.slug}/`}
              class="text-cdx-text-secondary hover:text-cdx-text group inline-flex items-center gap-2"
            >
              <span aria-hidden="true">←</span>
              <span class="flex flex-col">
                <span class="text-cdx-text-muted text-xs uppercase tracking-wider">Previous</span>
                <span class="group-hover:text-cdx-text">{prev.title}</span>
              </span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a
              href={`${base}guides/${next.slug}/`}
              class="text-cdx-text-secondary hover:text-cdx-text group inline-flex items-center gap-2 text-right"
            >
              <span class="flex flex-col">
                <span class="text-cdx-text-muted text-xs uppercase tracking-wider">Next</span>
                <span class="group-hover:text-cdx-text">{next.title}</span>
              </span>
              <span aria-hidden="true">→</span>
            </a>
          ) : (
            <span />
          )
        }
      </nav>
    </article>
  </div>
</Layout>
