---
import Layout from './Layout.astro';
import FeaturesSidebar, { guides } from '../components/FeaturesSidebar.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';

interface Props {
  currentSlug: string;
  title: string;
  description?: string;
}

const { currentSlug, title, description } = Astro.props;
const base = import.meta.env.BASE_URL;

const index = guides.findIndex((g) => g.slug === currentSlug);
const guide = guides[index];
const prev = index > 0 ? guides[index - 1] : null;
const next = index >= 0 && index < guides.length - 1 ? guides[index + 1] : null;

if (!guide) {
  throw new Error(`unknown guide slug: ${currentSlug}`);
}
---

<Layout title={title} description={description}>
  <div class="mx-auto max-w-6xl px-4 py-16 lg:grid lg:grid-cols-[14rem_1fr] lg:gap-10">
    <FeaturesSidebar currentSlug={currentSlug} />

    <article class="max-w-3xl">
      <header>
        <SectionEyebrow text={`Guide ${String(guide.number).padStart(2, '0')}`} />
        <h1 class="text-cdx-text mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
          {guide.title}
        </h1>
      </header>

      <div class="mt-10 space-y-6">
        <slot />
      </div>

      <nav
        class="border-cdx-border mt-20 flex items-center justify-between gap-4 border-t pt-8 text-sm"
        aria-label="Guide pagination"
      >
        {
          prev ? (
            <a
              href={`${base}features/${prev.slug}/`}
              class="text-cdx-text-secondary hover:text-cdx-text group inline-flex items-center gap-2"
            >
              <span aria-hidden="true">←</span>
              <span class="flex flex-col">
                <span class="text-cdx-text-muted text-xs uppercase tracking-wider">Previous</span>
                <span class="group-hover:text-cdx-text">{prev.title}</span>
              </span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a
              href={`${base}features/${next.slug}/`}
              class="text-cdx-text-secondary hover:text-cdx-text group inline-flex items-center gap-2 text-right"
            >
              <span class="flex flex-col">
                <span class="text-cdx-text-muted text-xs uppercase tracking-wider">Next</span>
                <span class="group-hover:text-cdx-text">{next.title}</span>
              </span>
              <span aria-hidden="true">→</span>
            </a>
          ) : (
            <span />
          )
        }
      </nav>
    </article>
  </div>
</Layout>
