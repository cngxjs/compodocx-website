---
import FeaturesLayout from '../../layouts/FeaturesLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';

interface TagGroup {
  id: string;
  heading: string;
  blurb: string;
  items: Array<[tag: string, desc: string]>;
}

const groups: TagGroup[] = [
  {
    id: 'members',
    heading: 'Members',
    blurb: 'Recognized on properties, methods, host listeners, accessors.',
    items: [
      ['@param', 'Paired with TypeScript type info. Descriptions thread onto constructor args.'],
      ['@returns', 'Return-value description.'],
      ['@example', 'Fenced code block, Shiki-highlighted.'],
      ['@see', 'Appended as a See-also link block.'],
      ['@since', 'Small version label next to the member name.'],
      [
        '@deprecated',
        'Strikethrough name plus a deprecation banner. Takes an optional reason string.',
      ],
    ],
  },
  {
    id: 'symbols',
    heading: 'Symbols',
    blurb: 'Class, interface, enum, type alias, function, variable.',
    items: [
      ['@example', 'Rendered as an Examples block on the Info tab. Multiple allowed.'],
      ['@see', 'See-also section with link resolution.'],
      ['@since / @deprecated', 'Same semantics as on members.'],
      ['@internal', 'Hides the symbol when --disableInternal is set.'],
      [
        '@feature <key>',
        'Puts the symbol into a feature of its entry point, above the detected one. The features config wins over the tag. It cannot move a symbol into another entry point.',
      ],
      [
        '@axis <name> <value>',
        'Sets the value on a classification axis declared in classificationAxes. Shows as a chip on the page and a search filter.',
      ],
    ],
  },
  {
    id: 'component-only',
    heading: 'Component-only',
    blurb: 'Component tags, plus the example marker that works on any class.',
    items: [
      ['@slot', 'Documents an exposed content slot. Renders as a metadata card on the Info tab.'],
      [
        '@playground',
        'Author-curated runnable demo. Surfaces a Playground tab with one StackBlitz launcher per block.',
      ],
      [
        '@playgroundConfig <path>',
        'Points all @playground blocks of the component at a .ts file that exports appConfig, for providers and routing.',
      ],
      [
        '<example-url>',
        'JSDoc marker pointing at a hosted demo URL. Surfaces an Examples tab with an iframe per URL. Counts only for the class whose comment holds it.',
      ],
    ],
  },
  {
    id: 'status-badges',
    heading: 'Status badges',
    blurb: 'Stamp the entity hero with status pills. Visible at the top of the rendered page.',
    items: [
      ['@beta', 'Adds a "Beta" badge.'],
      ['@breaking <version>', 'Adds a "Breaking" badge that pins the version.'],
      ['@since <version>', 'Adds a version badge to the entity hero.'],
    ],
  },
  {
    id: 'accessibility',
    heading: 'Accessibility',
    blurb:
      'Surface conformance metadata. The hero chip is the single user-visible signal; the free-form note travels with the entity for the LLM-md export and future reverse-lookups.',
    items: [
      [
        '@wcag A | AA | AAA',
        'Renders a coloured chip in the entity hero (neutral A, green AA, blue AAA). Case-insensitive. Invalid values log a build warning and skip the chip. Also emits a search filter so the command palette can narrow to a level.',
      ],
      [
        '@a11y <text>',
        'Free-form markdown accessibility note. Parsed and attached to the entity (IDep.a11yNote), exported through the llm-md bundle. Not rendered as a page section by design - the WCAG chip stays the only on-page conformance signal.',
      ],
    ],
  },
  {
    id: 'provenance',
    heading: 'Provenance',
    blurb:
      'Mark entities or markdown files as AI-assisted so readers can reason about source quality.',
    items: [
      [
        '@aiGenerated [label]',
        'JSDoc tag for entities and members (@ai and @aigen are synonyms). Shows an "AI generated" chip and a sentence with the optional value: a model name, a date, or key=value pairs. Set the text with aiGeneratedNote, hide it with --hideAiGeneratedBadge.',
      ],
      [
        '<!-- @aiGenerated [label] -->',
        'HTML-comment marker for markdown files. Place it on the first line of a README or additional page to flag the whole page with a banner.',
      ],
    ],
  },
  {
    id: 'hero-links',
    heading: 'Hero links',
    blurb: 'External links pinned to the entity hero. One per tag, multiple per entity.',
    items: [
      ['@github <url>', 'GitHub source / repo link.'],
      ['@figma <url>', 'Figma design file.'],
      ['@storybook <url>', 'Hosted Storybook entry.'],
      [
        '@stackblitz <url>',
        'Link to a StackBlitz project you maintain. For assembled demos use @playground.',
      ],
      ['@docs <url>', 'External documentation page.'],
    ],
  },
  {
    id: 'theming-tokens',
    heading: 'Theming tokens',
    blurb:
      'Parsed from /// blocks in SCSS and /** */ blocks in CSS, in component styles and files listed in styleFiles. Unknown tags are dropped and reported once per run.',
    items: [
      ['@overview', 'Description block at the top of the Theming tab.'],
      ['@type', 'Token type (e.g. color, length, duration).'],
      ['@default', 'Default value rendered next to the token name.'],
      ['@group', 'Groups tokens under an H4 in the Theming tab.'],
      ['@example / @since / @see', 'Same semantics as elsewhere.'],
      ['@deprecated', 'Optional reason. Empty marks deprecated without a message.'],
      ['@cssprop', 'Documents a property the component reads but never sets. Alias: @cssproperty.'],
      [
        '@themes <Name>',
        'File level. Links a style file to the components and directives it themes.',
      ],
      ['@relatedTo <Name>', 'Related-symbol links on a token, mixin, or style page.'],
      ['@internal', 'Hides the token, hook, mixin, or function from the docs.'],
    ],
  },
  {
    id: 'inline',
    heading: 'Inline',
    blurb: 'Used inside descriptions. Resolved at build time.',
    items: [
      [
        '{@link Symbol}',
        'Project-wide cross-reference, with an optional label ({@link Symbol|label}). Also takes URLs and Markdown files. A target that resolves to nothing renders as code.',
      ],
    ],
  },
];

const totalCount = groups.reduce((acc, g) => acc + g.items.length, 0);
---

<FeaturesLayout
  currentSlug="jsdoc-tags"
  title="JSDoc Tags - Recognized tags & rendering in compodocx"
  description="Every JSDoc tag compodocx recognizes - @param, @returns, @example, @deprecated, @internal, @feature, @axis, @wcag, @a11y, @aiGenerated, @see, @since, @link, @slot, @playground, hero links."
>
  <p class="text-cdx-text-secondary text-lg">
    {totalCount} recognized tags grouped by where they apply. Unknown tags are not an error: style comments
    drop them and report them in the build log. <code class="cdx-code">@category</code> and
    <code class="cdx-code">@docsKind</code> are no longer read; <code class="cdx-code"
      >compodocx migrate jsdoc</code
    >
    removes them.
  </p>

  <ul class="space-y-3" aria-label="JSDoc tag groups">
    {
      groups.map((group, idx) => (
        <li>
          <details
            id={group.id}
            class="bg-cdx-bg-elevated faq-item group rounded-xl scroll-mt-24"
            open={idx === 0 ? true : undefined}
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-xl p-5">
              <span class="flex items-baseline gap-3">
                <span class="text-cdx-text text-base font-semibold tracking-tight">
                  {group.heading}
                </span>
                <span class="text-cdx-text-secondary font-mono text-xs">
                  {group.items.length} {group.items.length === 1 ? 'tag' : 'tags'}
                </span>
              </span>
              <span
                aria-hidden="true"
                class="text-cdx-text-secondary group-hover:text-cdx-primary inline-flex size-7 shrink-0 items-center justify-center rounded-md transition-transform group-open:rotate-180"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </span>
            </summary>
            <div class="px-5 pb-5">
              <p class="text-cdx-text-secondary mb-4 text-sm leading-relaxed">{group.blurb}</p>
              <dl class="grid gap-x-6 gap-y-2.5 text-sm sm:grid-cols-[auto_1fr]">
                {group.items.map(([tag, desc]) => (
                  <>
                    <dt class="min-w-0">
                      <code class="cdx-code whitespace-nowrap">{tag}</code>
                    </dt>
                    <dd class="text-cdx-text-secondary leading-relaxed">{desc}</dd>
                  </>
                ))}
              </dl>
            </div>
          </details>
        </li>
      ))
    }
  </ul>

  <h2>Theming token example</h2>
  <p>
    The token block sits above the actual property declaration. <code class="cdx-code"
      >@overview</code
    >
    blocks at file-level open the Theming tab. Per-token blocks fill the catalog.
  </p>
  <CodeBlock
    lang="css"
    code={`/**
 * @overview Card surface tokens.
 */

/**
 * Background of the card body.
 *
 * @type color
 * @default hsl(220 20% 98%)
 * @group Surface
 * @since 1.4.0
 * @example
 *   --color-app-card-bg: var(--color-cdx-bg-elevated);
 */
--color-app-card-bg: hsl(220 20% 98%);`}
  />
</FeaturesLayout>

<style>
  /* Hide the default disclosure triangle in Safari/Chrome (same pattern as FAQ + themes) */
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
</style>
