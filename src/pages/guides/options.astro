---
import FeaturesLayout from '../../layouts/FeaturesLayout.astro';

interface Opt {
  /** Config-file key + primary visible name. */
  key: string;
  /** CLI flag string ("-n, --name"). Empty = config-only option. */
  cli?: string;
  /** Type signature: 'string', 'number', 'boolean', 'string[]', 'object[]'. */
  type: string;
  /** Default value as written. Missing = required or no default. */
  default?: string;
  /** Description (plain text). */
  desc: string;
}

interface OptGroup {
  id: string;
  heading: string;
  blurb?: string;
  items: Opt[];
}

const groups: OptGroup[] = [
  {
    id: 'general',
    heading: 'General',
    blurb: 'Identity, language, and the entry point to your project.',
    items: [
      {
        key: 'tsconfig',
        cli: '-p, --tsconfig',
        type: 'string',
        desc: "Path to the project's tsconfig.json. Required - compodocx uses TypeScript's compiler to analyze the source.",
      },
      {
        key: 'name',
        cli: '-n, --name',
        type: 'string',
        default: "'Application documentation'",
        desc: 'Title shown in the sidebar header, browser tab, and <title> of every generated page.',
      },
      {
        key: 'language',
        cli: '--language',
        type: 'string',
        default: "'en-US'",
        desc: 'UI language. bg-BG, de-DE, en-US, es-ES, fr-FR, hu-HU, it-IT, ja-JP, ka-GE, ko-KR, nl-NL, pl-PL, pt-BR, ru-RU, sk-SK, zh-CN, zh-TW.',
      },
      {
        key: 'config',
        cli: '-c, --config',
        type: 'string',
        desc: 'Explicit config-file path. Otherwise compodocx searches the working folder for .compodocxrc, .compodocxrc.json, .compodocxrc.yaml, compodocx.config.*, or a compodocx key in package.json, then the same compodoc names.',
      },
      {
        key: 'include',
        type: 'string[]',
        desc: "Extra globs of source files to document, relative to the tsconfig folder. Added to the tsconfig's include list.",
      },
      {
        key: 'exclude',
        type: 'string[]',
        default: "['**/.git', '**/node_modules', '**/*.d.ts', '**/*.spec.ts']",
        desc: "Globs of source files to skip, relative to the tsconfig folder. Replaces the default list, so repeat its entries to keep them. Combined with the tsconfig's exclude list.",
      },
    ],
  },
  {
    id: 'output',
    heading: 'Output',
    blurb: 'Where the static site lands and which export format it uses.',
    items: [
      {
        key: 'output',
        cli: '-d, --output',
        type: 'string',
        default: "'./documentation/'",
        desc: 'Directory for the generated static site. Created if missing. Contents are overwritten on each run.',
      },
      {
        key: 'exportFormat',
        cli: '-e, --exportFormat',
        type: 'string',
        default: "'html'",
        desc: "Output format. 'html' = full static site. 'json' = data model in <output>/documentation.json. 'llm-md' = one Markdown file, to stdout without an output folder, else <output>/llm-context.md.",
      },
      {
        key: 'multiVersion',
        cli: '--multiVersion / --no-multiVersion',
        type: 'boolean',
        default: 'true',
        desc: 'Multi-version layout on by default - writes <output>/<versionLabel>/ and maintains versions.json. Disable for a flat single-version layout. Non-HTML exports ignore this flag.',
      },
      {
        key: 'versionLabel',
        cli: '--versionLabel',
        type: 'string',
        default: 'auto',
        desc: 'Override the version-subfolder name. Default: nearest package.json version, prefixed with v (1.2.3 → v1.2.3). Use main, next, unreleased for non-package builds.',
      },
      {
        key: 'versionsRoot',
        cli: '--versionsRoot',
        type: 'string',
        default: 'the -d folder',
        desc: 'Where versions.json is read/written. Override when CI builds each version separately and stitches deploys later.',
      },
      {
        key: 'maxVersionsShown',
        cli: '--maxVersionsShown',
        type: 'number',
        default: '10',
        desc: 'Cap on switcher dropdown entries. 0 = unlimited. Manifest is always written in full - this is presentation-only. Range 0–1000.',
      },
      {
        key: 'jsonIndent',
        cli: '--jsonIndent',
        type: 'number',
        default: '0',
        desc: 'Indent of documentation.json. 0 writes one line, 1–8 pretty-prints. Any other value stops the build.',
      },
    ],
  },
  {
    id: 'serving',
    heading: 'Dev server',
    blurb: 'Built-in HTTP server for previewing locally.',
    items: [
      {
        key: 'serve',
        cli: '-s, --serve',
        type: 'boolean',
        default: 'false',
        desc: 'Start a local HTTP server after generation. Serves the output directory.',
      },
      {
        key: 'port',
        cli: '-r, --port',
        type: 'number',
        default: '8080',
        desc: 'Port for the dev server.',
      },
      {
        key: 'host',
        cli: '--host',
        type: 'string',
        default: "'127.0.0.1'",
        desc: 'Host address. Set to 0.0.0.0 to expose on the network.',
      },
      {
        key: 'watch',
        cli: '-w, --watch',
        type: 'boolean',
        default: 'false',
        desc: "Watch the documented project's source and rebuild on changes. Requires --serve. Watches the target project, not compodocx itself.",
      },
      {
        key: 'open',
        cli: '-o, --open',
        type: 'boolean',
        default: 'false',
        desc: 'Open the documentation in the default browser after serving.',
      },
    ],
  },
  {
    id: 'theming',
    heading: 'Theming & branding',
    blurb: 'Built-in palettes, custom CSS, logo, favicon.',
    items: [
      {
        key: 'theme',
        cli: '--theme',
        type: 'string',
        default: "'default'",
        desc: 'Built-in theme name or path to a custom CSS file. Built-in: default, ocean, ember, midnight, neon, brutalist, nord, rose-pine. Custom CSS replaces the built-in. Upstream compodoc theme names warn and map to a built-in.',
      },
      {
        key: 'shikiTheme',
        cli: '--shikiTheme',
        type: 'string',
        default: "'github-light:github-dark'",
        desc: "Shiki syntax highlighting pair for code blocks. Format 'light:dark' or single name for both modes. Uses Shiki's bundled themes.",
      },
      {
        key: 'customLogo',
        cli: '--customLogo',
        type: 'string',
        desc: 'Path to a custom logo image displayed in the sidebar header. Its size follows its aspect ratio; see logoLayout.',
      },
      {
        key: 'customLogoDark',
        cli: '--customLogoDark',
        type: 'string',
        desc: 'Logo shown instead of customLogo while dark mode is on. Needs customLogo and a different file name.',
      },
      {
        key: 'logoLayout',
        cli: '--logoLayout',
        type: "'auto' | 'icon' | 'wordmark'",
        default: "'auto'",
        desc: "'wordmark' = the logo alone. 'icon' = the logo next to the project name. 'auto' reads the aspect ratio of an SVG or PNG: 2:1 and wider is a wordmark.",
      },
      {
        key: 'customFavicon',
        cli: '--customFavicon',
        type: 'string',
        desc: 'Path to a custom favicon (.svg, .ico, or .png). Copied to images/favicon.<ext> and linked in every page instead of the bundled icon.',
      },
      {
        key: 'hideGenerator',
        cli: '--hideGenerator',
        type: 'boolean',
        default: 'false',
        desc: 'Remove the "Built with compodocx" link in the page footer.',
      },
      {
        key: 'hideDarkModeToggle',
        cli: '--hideDarkModeToggle',
        type: 'boolean',
        default: 'false',
        desc: 'Remove the light/dark toggle from the top-right header.',
      },
      {
        key: 'hideAiGeneratedBadge',
        cli: '--hideAiGeneratedBadge',
        type: 'boolean',
        default: 'false',
        desc: 'Hide the "AI generated" chip, sentence, and banner on every page. The JSON and llm-md exports keep the aiGenerated fields.',
      },
      {
        key: 'styleFiles',
        type: 'string[]',
        default: '[]',
        desc: "Globs of free-standing .css / .scss files to document, relative to the config file's folder: theme bridges, directive assets, global token sheets. They join features like symbols.",
      },
      {
        key: 'themingPrivatePrefix',
        type: 'string | false',
        default: "'--_'",
        desc: 'Prefix of custom properties hidden from the docs. false lists every property.',
      },
      {
        key: 'extTheme',
        cli: '-y, --extTheme',
        type: 'string',
        desc: 'DEPRECATED. Use --theme. When set without --theme, treated as a custom theme path.',
      },
    ],
  },
  {
    id: 'visibility',
    heading: 'Visibility filters',
    blurb: 'Hide individual member groups (the entity page still exists).',
    items: [
      {
        key: 'disablePrivate',
        cli: '--disablePrivate',
        type: 'boolean',
        default: 'false',
        desc: 'Hide private members from all entity pages. Affects properties, methods, accessors marked private.',
      },
      {
        key: 'disableProtected',
        cli: '--disableProtected',
        type: 'boolean',
        default: 'false',
        desc: 'Hide protected members from all entity pages.',
      },
      {
        key: 'disableInternal',
        cli: '--disableInternal',
        type: 'boolean',
        default: 'false',
        desc: 'Hide members marked with @internal JSDoc tag.',
      },
      {
        key: 'disableLifeCycleHooks',
        cli: '--disableLifeCycleHooks',
        type: 'boolean',
        default: 'false',
        desc: 'Hide Angular lifecycle hooks (ngOnInit, ngOnDestroy, etc.) from method listings.',
      },
      {
        key: 'disableConstructors',
        cli: '--disableConstructors',
        type: 'boolean',
        default: 'false',
        desc: 'Hide the constructor section from entity pages.',
      },
      {
        key: 'disableProperties',
        cli: '--disableProperties',
        type: 'boolean',
        default: 'false',
        desc: 'Hide the entire properties section (inputs, outputs, regular properties).',
      },
      {
        key: 'disableDependencies',
        cli: '--disableDependencies',
        type: 'boolean',
        default: 'false',
        desc: 'Hide the dependencies section on the Info tab, which shows the inject() calls of the class.',
      },
      {
        key: 'disableFilePath',
        cli: '--disableFilePath',
        type: 'boolean',
        default: 'false',
        desc: 'Hide the source file path shown in the entity hero.',
      },
      {
        key: 'showEffects',
        cli: '--showEffects',
        type: 'boolean',
        default: 'false',
        desc: 'Show effect(), afterRenderEffect(), and similar members in a dedicated Effects block on the API tab. Off by default, when they appear as regular properties, since effects are usually implementation details.',
      },
      {
        key: 'publicApiOnly',
        cli: '--publicApiOnly',
        type: 'string',
        desc: 'Restrict the docs to the public API. Names come from *.api.md reports below the tsconfig folder, else from index.d.ts files or the exports[*].types declarations in the given dist folder. Useful for library authors.',
      },
    ],
  },
  {
    id: 'features',
    heading: 'Feature toggles',
    blurb: 'Disable entire features, tabs, or pages.',
    items: [
      {
        key: 'minimal',
        cli: '--minimal',
        type: 'boolean',
        default: 'false',
        desc: 'Shorthand: disables search, all graphs, routes, and coverage in one flag. Equivalent to --disableSearch --disableGraph --disableRoutes --disableCoverage.',
      },
      {
        key: 'disableSourceCode',
        cli: '--disableSourceCode',
        type: 'boolean',
        default: 'false',
        desc: 'Remove the Source tab and all "Defined in" source links. No source code in output.',
      },
      {
        key: 'disableDomTree',
        cli: '--disableDomTree',
        type: 'boolean',
        default: 'false',
        desc: 'Remove the DOM Tree tab from component pages.',
      },
      {
        key: 'disableTemplateTab',
        cli: '--disableTemplateTab',
        type: 'boolean',
        default: 'false',
        desc: 'Remove the Template tab from component pages.',
      },
      {
        key: 'disableStyleTab',
        cli: '--disableStyleTab',
        type: 'boolean',
        default: 'false',
        desc: 'Remove the Style tab from component pages.',
      },
      {
        key: 'disableGraph',
        cli: '--disableGraph',
        type: 'boolean',
        default: 'false',
        desc: 'Remove the dependency graph from the overview page; js/graph.js is not written. The per-component tab is controlled by disableDependenciesTab.',
      },
      {
        key: 'disableDependenciesTab',
        cli: '--disableDependenciesTab',
        type: 'boolean',
        default: 'false',
        desc: "Remove the per-component Dependencies tab, which shows the component's neighbourhood in the dependency graph.",
      },
      {
        key: 'disableRoutes',
        cli: '--disableRoutes',
        type: 'boolean',
        default: 'false',
        desc: 'Do not read routes: no routes page, menu entry, route links, palette entries, or exported routes.',
      },
      {
        key: 'disableSearch',
        cli: '--disableSearch',
        type: 'boolean',
        default: 'false',
        desc: 'Remove Pagefind search. Disables the Ctrl+K palette and skips index generation at build.',
      },
      {
        key: 'disableCoverage',
        cli: '--disableCoverage',
        type: 'boolean',
        default: 'false',
        desc: 'Remove the documentation coverage report page.',
      },
      {
        key: 'disableOverview',
        cli: '--disableOverview',
        type: 'boolean',
        default: 'false',
        desc: 'Remove the overview/dashboard page (project-level statistics + main graph).',
      },
      {
        key: 'disableMarkdownPages',
        cli: '--disableMarkdownPages',
        type: 'string[]',
        default: '[]',
        desc: 'Root Markdown files not to build as pages: changelog, contributing, license, todo. Comma-separated on the CLI.',
      },
    ],
  },
  {
    id: 'navigation',
    heading: 'Navigation & layout',
    blurb: 'Which chapters start open, entity-page tab order, and the base of example URLs.',
    items: [
      {
        key: 'toggleMenuItems',
        cli: '--toggleMenuItems',
        type: 'string[]',
        default: "['all']",
        desc: "Sidebar chapters that start open. The default ['all'] keeps every chapter collapsed. Otherwise list them, comma-separated on the CLI: components, directives, entities, classes, injectables, services, dependency-injection, guards, interfaces, namespaces, interceptors, pipes, resolvers, utilities, styles, additionalPages, features. collapsedAll overrides this list.",
      },
      {
        key: 'navTabConfig',
        cli: '--navTabConfig',
        type: 'object[]',
        default: '[]',
        desc: 'Customize entity-page tab order/labels. Array of { id, label }. Tab IDs: info, readme, api, source, templateData, styleData, theming, tree, example, playground. Tabs not listed are hidden. Empty (default) shows all in default order.',
      },
      {
        key: 'exampleUrlBase',
        cli: '--exampleUrlBase',
        type: 'string',
        default: "''",
        desc: 'Base URL for relative <example-url> tags. Absolute URLs stay as written. Also applied to exampleUrls in the JSON export.',
      },
    ],
  },
  {
    id: 'tab-sections',
    heading: 'Tab sections (config-only)',
    blurb:
      'Compose the section list inside Info / API / Theming tabs. No CLI flag - set in the config file.',
    items: [
      {
        key: 'infoTabSections',
        type: 'string[]',
        default: '[]',
        desc: 'Override the section list for the Info tab. Empty = all defaults render. IDs: import, deprecated, description, examples, metadata, extends, host, dependencies, providers, viewProviders, relationships.',
      },
      {
        key: 'apiTabSections',
        type: 'string[]',
        default: '[]',
        desc: 'Override the section list for the API tab. IDs: index, inputs, outputs, derivedState, effects, properties, methods, accessors, indexSignatures, hostBindings, hostListeners.',
      },
      {
        key: 'themingTabSections',
        type: 'string[]',
        default: '[]',
        desc: 'Override the section list for the Theming tab. IDs: overview, index, tokens, mixins, source.',
      },
    ],
  },
  {
    id: 'coverage',
    heading: 'Coverage',
    blurb: 'Documentation-coverage thresholds and reporting.',
    items: [
      {
        key: 'coverageTest',
        cli: '--coverageTest',
        type: 'number',
        default: 'off',
        desc: 'Global documentation-coverage threshold as a percentage; setting it turns the test on. The flag without a value uses 70. Used in CI to enforce minimum documentation.',
      },
      {
        key: 'coverageMinimumPerFile',
        cli: '--coverageMinimumPerFile',
        type: 'number',
        default: 'off',
        desc: 'Per-file minimum coverage percentage; setting it turns the per-file test on. Each file must individually meet the threshold.',
      },
      {
        key: 'coverageTestThresholdFail',
        cli: '--coverageTestThresholdFail',
        type: 'boolean',
        default: 'true',
        desc: 'When true, a coverage breach exits non-zero (fails CI). When false, only a warning is printed.',
      },
      {
        key: 'coverageTestShowOnlyFailed',
        cli: '--coverageTestShowOnlyFailed',
        type: 'boolean',
        default: 'false',
        desc: 'Show only files below the threshold in coverage output.',
      },
      {
        key: 'files',
        cli: '--files',
        type: 'string',
        desc: 'Run only the per-file coverage test on the given files and generate no docs; needs --coverageMinimumPerFile. Repeat the flag for several files. The files config key instead adds source files to the documented set.',
      },
      {
        key: 'unitTestCoverage',
        cli: '--unitTestCoverage',
        type: 'string',
        desc: 'Path to an Istanbul JSON coverage summary (coverage-summary.json). Integrates unit-test coverage data into the documentation coverage report.',
      },
    ],
  },
  {
    id: 'sidebar-grouping',
    heading: 'Sidebar grouping',
    blurb: 'How symbols are grouped into features and shown in the sidebar. Config-only.',
    items: [
      {
        key: 'menuLayout',
        type: "'feature' | 'type'",
        default: "'feature'",
        desc: "Whole-sidebar layout. 'feature' = one Features chapter with entry points as a tree of their import path, each feature below its entry point, plus a link to the references.html portal. 'type' = one chapter per kind, each grouped by feature.",
      },
      {
        key: 'menuFeatureSections',
        type: 'object',
        default: "{ configuration: 'own', utilities: 'more', constants: 'more', types: 'more' }",
        desc: "Where each member role of a feature shows under menuLayout: 'feature'. Values: own, more, top, hidden. A hidden role stays on the feature page, in the API reference, and in search.",
      },
      {
        key: 'collapsedAll',
        type: 'boolean',
        default: 'false',
        desc: 'Start every sidebar chapter and nested group collapsed on first load. Overrides toggleMenuItems. Useful for large codebases.',
      },
      {
        key: 'featuresName',
        type: 'string',
        default: "''",
        desc: "Override the heading of the Features chapter under menuLayout: 'feature'. Empty uses the translated default.",
      },
      {
        key: 'referencesName',
        type: 'string',
        default: "''",
        desc: 'Exposed on data.referencesName for menu and api-reference template overrides. The built-in sidebar link and portal heading use their translated labels.',
      },
      {
        key: 'features',
        type: 'object',
        default: '{}',
        desc: 'Feature keys by file glob, for example { "projects/forms/select/src/**": "select" }. The first matching glob wins, above @feature tags and detection. It never moves a symbol into another entry point.',
      },
      {
        key: 'featureContainers',
        type: 'string[]',
        default: "['features', 'pages', 'domains']",
        desc: 'App folders whose sub-folders are the features: src/app/features/admin gives the feature admin.',
      },
      {
        key: 'featureUtilityFolders',
        type: 'string[]',
        default: "['internal', 'i18n', 'utils', 'testing', '__test-helpers', 'examples']",
        desc: 'Folders below an entry point that belong to its root feature instead of forming a feature of their own.',
      },
      {
        key: 'featureRoleFolders',
        type: 'string[]',
        default: "['config', 'di', 'providers', 'services', 'components', ...]",
        desc: 'Folders named after a role. A file in one joins the feature its file name starts with: di/toast.providers.ts joins toast. [] turns the rule off.',
      },
      {
        key: 'classificationAxes',
        type: 'object',
        default: '{}',
        desc: 'Axes of your own, such as stability or platform, each with its allowed values. A symbol gets its value from an @axis tag, a file glob, or the default. Each shows as a chip on the page and a search filter. Axes never change URLs or the sidebar.',
      },
    ],
  },
  {
    id: 'additional-content',
    heading: 'Additional content',
    blurb: 'External markdown, static assets, and template overrides.',
    items: [
      {
        key: 'includes',
        cli: '--includes',
        type: 'string',
        desc: 'Folder of external markdown files with a summary.json table of contents. Each listed page gets a sidebar entry, and nested nodes form sub-navigation. A missing folder is reported with a warning.',
      },
      {
        key: 'includesName',
        cli: '--includesName',
        type: 'string',
        default: "'Additional documentation'",
        desc: 'Sidebar label for the external markdown pages section.',
      },
      {
        key: 'includesLabels',
        cli: '--includesLabels',
        type: 'string',
        desc: 'Path to a JSON file keyed by page slug, each entry with an optional label, title, and tooltip. Read only when includes is set.',
      },
      {
        key: 'includesTooltips',
        cli: '--includesTooltips',
        type: 'boolean',
        default: 'false',
        desc: 'Show the subtitle of each additional page, or its tooltip key, as the tooltip of its sidebar link.',
      },
      {
        key: 'aiGeneratedNote',
        type: 'string',
        default: "''",
        desc: 'Sentence next to the "AI generated" chip. {value} stands for the marker value; {key} fills a key=value field. Empty uses the translated default.',
      },
      {
        key: 'assetsFolder',
        cli: '-a, --assetsFolder',
        type: 'string',
        desc: 'Folder of static assets (images, files) copied into output. Reference from markdown or templates via relative paths.',
      },
      {
        key: 'templates',
        cli: '--templates',
        type: 'string',
        desc: 'Directory of JS template overrides. Each file exports (data, helpers) => string and replaces the corresponding built-in. Override names match the emitted page kind (component, directive, pipe, injectable, service, token, class, guard, interceptor, resolver, interface, entity, namespace, feature, style, routes, design-tokens, utilities, dependency-injection, function, variable, typealias, enumeration, api-reference, additional-page, …) or block (referenced-by, block-routed-at, block-theming, block-playground, version-switcher, …). Handlebars .hbs files are skipped with one warning.',
      },
    ],
  },
  {
    id: 'playground',
    heading: 'Playground (@playground)',
    blurb:
      'Runnable StackBlitz demos via @playground JSDoc blocks. See the Playground guide for the full authoring story.',
    items: [
      {
        key: 'disablePlaygroundTab',
        cli: '--disablePlaygroundTab',
        type: 'boolean',
        default: 'false',
        desc: 'Hide the per-component Playground tab even when @playground blocks are parsed. Independent of --disableDependenciesTab. No effect on components without @playground blocks (the tab is already absent).',
      },
      {
        key: 'playgroundDependencies',
        type: 'object',
        default: '{}',
        desc: "Extra packages to inject into every StackBlitz manifest's dependencies, with the version YOU specify. Wins over the consumer-package.json auto-forward AND any auto-detected version (e.g. Material). Use for libraries the consumer ships but doesn't npm install directly (peer-only CSS themes), or to pin a per-build version. The value is forwarded unchanged, so dist-tags, tarball URLs, and git refs work.",
      },
      {
        key: 'strictPlaygrounds',
        cli: '--strictPlaygrounds',
        type: 'boolean',
        default: 'false',
        desc: 'Fail the build when a non-vendored @playground imports a subpath or symbol the pinned package version does not have. Off, it only warns.',
      },
      {
        key: 'playgroundVendor',
        type: 'string[]',
        default: '[]',
        desc: 'Package names or globs to embed from the local build instead of the npm registry, so a playground runs against your working tree. Fails the build when a build output is missing.',
      },
      {
        key: 'playgroundVendorRoot',
        type: 'string',
        default: "'dist'",
        desc: 'Base directory the playgroundVendor closure is read from.',
      },
      {
        key: 'playgroundVendorCap',
        type: 'number',
        default: '1500000',
        desc: "Backstop byte cap on one playground's vendored closure, under the roughly 2 MB StackBlitz POST limit. Range 50 000–2 000 000.",
      },
      {
        key: 'playgroundVendorIncludeSourcemaps',
        type: 'boolean',
        default: 'false',
        desc: 'Keep *.map sourcemaps in vendored packages.',
      },
      {
        key: 'playgroundDepDepth',
        type: 'number',
        default: '3',
        desc: "Max import depth followed when walking a playground's dependency graph. Range 1–100.",
      },
      {
        key: 'playgroundFileCountCap',
        type: 'number',
        default: '25',
        desc: 'Ceiling on source files in one playground manifest. Going over fails that playground. Range 1–1000.',
      },
      {
        key: 'playgroundFileCap',
        type: 'number',
        default: '8000',
        desc: 'Per-file character cap before a bundled source is truncated with a footer. Range 500–1,000,000.',
      },
      {
        key: 'playgroundMaterialShell',
        type: 'boolean',
        default: 'false',
        desc: 'Force the Roboto and Material-Icons links and the Material body classes into every playground, without adding Angular Material. For libraries themed to look like Material.',
      },
      {
        key: 'playgroundHead',
        type: 'string[]',
        default: '[]',
        desc: 'Entries injected into the <head> of every playground, emitted verbatim.',
      },
      {
        key: 'playgroundGlobalStyles',
        type: 'string',
        default: "''",
        desc: 'Global styles appended to every playground stylesheet. A Sass @use or @forward switches the sheet to src/styles.scss.',
      },
    ],
  },
  {
    id: 'integrations',
    heading: 'Analytics',
    blurb: 'Google Analytics 4 tracking for the generated site.',
    items: [
      {
        key: 'gaID',
        cli: '--gaID',
        type: 'string',
        desc: 'Google Analytics 4 measurement ID (G-XXXXXXXXXX). When set, gtag.js is injected into every page.',
      },
    ],
  },
  {
    id: 'search-misc',
    heading: 'Search & logging',
    blurb: 'Pagefind result cap and CLI verbosity.',
    items: [
      {
        key: 'maxSearchResults',
        cli: '--maxSearchResults',
        type: 'number',
        default: '15',
        desc: 'Maximum results in the Ctrl+K search palette. 0 = all (may be slow for large projects). Integer from 0 to 10000.',
      },
      {
        key: 'searchFacetLimit',
        cli: '--searchFacetLimit',
        type: 'number',
        default: '8',
        desc: 'Filter chips each facet of the palette shows before a "+N more" toggle. 0 = all. Integer from 0 to 1000.',
      },
      {
        key: 'silent',
        cli: '-t, --silent',
        type: 'boolean',
        default: 'false',
        desc: 'Suppress all console output during generation. Useful in CI where only the exit code matters.',
      },
      {
        key: 'verbose',
        cli: '--verbose',
        type: 'boolean',
        default: 'false',
        desc: 'Also print debug lines: one per symbol found, file scanned, and symbol skipped. --silent wins.',
      },
    ],
  },
];

const totalCount = groups.reduce((acc, g) => acc + g.items.length, 0);
---

<FeaturesLayout
  currentSlug="options"
  title="Options - compodocx CLI flags and config reference"
  description="Complete compodocx options reference. CLI flags + JSON config keys for entry, output, theming, visibility, feature toggles, navigation, coverage, and integrations."
>
  <p class="text-cdx-text-secondary text-lg">
    compodocx accepts CLI flags or a config file (<code class="cdx-code">.compodocxrc</code>,
    <code class="cdx-code">.compodocxrc.json</code>, <code class="cdx-code">.compodocxrc.yaml</code
    >, or a <code class="cdx-code">compodocx</code> property in <code class="cdx-code"
      >package.json</code
    >). Flags override config values. {totalCount} options total, grouped below.
  </p>
  <p>
    Relative paths in a config file resolve against the folder of that file; flags resolve against
    the working directory. Flags and keys from compodoc that no longer exist are ignored with a
    warning.
  </p>

  <nav aria-label="Options categories" class="bg-cdx-bg-elevated mt-6 rounded-xl p-4">
    <p class="text-cdx-text-secondary text-xs font-semibold uppercase tracking-[0.2em]">Jump to</p>
    <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm">
      {
        groups.map((g) => (
          <li>
            <a href={`#${g.id}`} class="text-cdx-primary underline underline-offset-2">
              {g.heading}
              <span class="text-cdx-text-muted text-xs">({g.items.length})</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    groups.map((group) => (
      <section
        id={group.id}
        tabindex="-1"
        aria-labelledby={`${group.id}-heading`}
        class="scroll-mt-24 focus:outline-none"
      >
        <h2 id={`${group.id}-heading`}>{group.heading}</h2>
        {group.blurb && <p>{group.blurb}</p>}
        <dl class="mt-4 grid gap-3">
          {group.items.map((opt) => (
            <div class="bg-cdx-bg-elevated rounded-xl p-4">
              <dt class="flex flex-wrap items-baseline gap-x-3 gap-y-1.5">
                <code class="cdx-code text-sm">{opt.cli ?? opt.key}</code>
                <span class="text-cdx-text-muted font-mono text-xs">{opt.type}</span>
                {opt.default !== undefined && (
                  <span class="text-cdx-text-secondary text-xs">
                    default: <code class="cdx-code">{opt.default}</code>
                  </span>
                )}
                {!opt.cli && (
                  <span class="text-cdx-text-muted text-[10px] font-semibold tracking-wider uppercase">
                    config-only
                  </span>
                )}
              </dt>
              <dd class="text-cdx-text-secondary mt-2.5 text-sm leading-relaxed">{opt.desc}</dd>
            </div>
          ))}
        </dl>
      </section>
    ))
  }

  <p class="text-cdx-text-secondary pt-8 text-sm">
    Run <code class="cdx-code">compodocx --help</code> for the same surface from the terminal. Options
    are resolved CLI &gt; config file &gt; defaults.
  </p>
</FeaturesLayout>
