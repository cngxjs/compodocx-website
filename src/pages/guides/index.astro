---
import Layout from '../../layouts/Layout.astro';
import FeaturesSidebar, { guides } from '../../components/FeaturesSidebar.astro';
import SectionEyebrow from '../../components/SectionEyebrow.astro';

const base = import.meta.env.BASE_URL;
const siteUrl = Astro.site ?? new URL(base, 'https://cngxjs.github.io');

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'compodocx Guides',
  description: 'Reference guides covering the full compodocx feature surface.',
  url: new URL(`${base}guides/`, siteUrl).href,
  inLanguage: 'en',
  isPartOf: { '@id': `${new URL(base, siteUrl).href}#website` },
  hasPart: guides.map((g, idx) => ({
    '@type': 'TechArticle',
    position: idx + 1,
    name: g.title,
    url: new URL(`${base}guides/${g.slug}/`, siteUrl).href,
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL(base, siteUrl).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Guides',
      item: new URL(`${base}guides/`, siteUrl).href,
    },
  ],
};
---

<Layout
  title="Guides — compodocx"
  description="Twelve compodocx guides — Getting Started, Features, Options, Usage, Themes, JSDoc Tags, Routing, Documentation Coverage, and more. Everything you need to ship Angular docs."
  jsonLd={[collectionJsonLd, breadcrumbJsonLd]}
>
  <div class="mx-auto max-w-6xl px-4 py-16 lg:grid lg:grid-cols-[14rem_1fr] lg:gap-10">
    <FeaturesSidebar currentSlug="" />

    <div class="mx-auto max-w-3xl">
      <SectionEyebrow text="Reference" />
      <h1 class="text-cdx-text mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
        Everything compodocx documents
      </h1>
      <p class="text-cdx-text-secondary mt-4 text-lg">
        Twelve guides covering the output surface — what compodocx renders, how it&rsquo;s
        configured, and the integration points worth knowing about before you adopt it.
      </p>

      <ul class="mt-12 grid gap-3 md:grid-cols-2">
        {
          guides.map((g) => (
            <li>
              <a
                href={`${base}guides/${g.slug}/`}
                class="bg-cdx-bg-elevated hover:bg-cdx-bg-alt group flex items-center gap-4 rounded-xl p-4 transition-colors"
              >
                <span class="text-cdx-text-muted bg-cdx-bg-alt inline-flex size-10 items-center justify-center rounded-lg font-mono text-xs">
                  {String(g.number).padStart(2, '0')}
                </span>
                <span class="text-cdx-text font-semibold">{g.title}</span>
                <span
                  class="text-cdx-text-muted group-hover:text-cdx-text ml-auto"
                  aria-hidden="true"
                >
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Layout>
