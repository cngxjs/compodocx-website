---
import Layout from '../../layouts/Layout.astro';
import FeaturesSidebar, { guides } from '../../components/FeaturesSidebar.astro';
import SectionEyebrow from '../../components/SectionEyebrow.astro';

const base = import.meta.env.BASE_URL;
const siteUrl = Astro.site ?? new URL(base, 'https://cngxjs.github.io');

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'compodocx Guides',
  description: 'Reference guides covering the full compodocx feature surface.',
  url: new URL(`${base}guides/`, siteUrl).href,
  inLanguage: 'en',
  isPartOf: { '@id': `${new URL(base, siteUrl).href}#website` },
  hasPart: guides.map((g, idx) => ({
    '@type': 'TechArticle',
    position: idx + 1,
    name: g.title,
    url: new URL(`${base}guides/${g.slug}/`, siteUrl).href,
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL(base, siteUrl).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Guides',
      item: new URL(`${base}guides/`, siteUrl).href,
    },
  ],
};
---

<Layout
  title="Guides — compodocx documentation reference (12 guides)"
  description="Twelve compodocx guides — Getting Started, Features, Options, Usage, Themes, JSDoc Tags, Routing, Documentation Coverage, and more. Everything you need to ship Angular docs."
  jsonLd={[collectionJsonLd, breadcrumbJsonLd]}
>
  <div class="mx-auto max-w-6xl px-4 py-16 lg:grid lg:grid-cols-[14rem_1fr] lg:gap-10">
    <FeaturesSidebar currentSlug="" />

    <div class="min-w-0">
      <hgroup>
        <SectionEyebrow text="Reference" />
        <h1 class="text-cdx-text mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
          Everything compodocx documents
        </h1>
      </hgroup>
      <p class="text-cdx-text-secondary mt-4 max-w-2xl text-lg leading-relaxed">
        Twelve reference guides covering install through multi-version output. Skim, skip around, or
        read end to end.
      </p>

      <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          guides.map((g) => (
            <li>
              <a
                href={`${base}guides/${g.slug}/`}
                class="bg-cdx-bg-elevated hover:bg-cdx-bg-alt focus-visible:ring-cdx-primary group flex h-full flex-col gap-3 rounded-xl p-5 transition-colors focus-visible:ring-2 focus-visible:outline-none"
              >
                <div class="flex items-center gap-3">
                  <span
                    aria-hidden="true"
                    class="bg-cdx-primary text-cdx-text-inverse inline-flex size-9 items-center justify-center rounded-lg font-mono text-sm font-bold"
                  >
                    {String(g.number).padStart(2, '0')}
                  </span>
                  <span class="text-cdx-text text-base font-semibold tracking-tight">
                    {g.title}
                  </span>
                  <span
                    aria-hidden="true"
                    class="text-cdx-text-secondary group-hover:text-cdx-primary ml-auto transition-all group-hover:translate-x-0.5"
                  >
                    →
                  </span>
                </div>
                <p class="text-cdx-text-secondary text-sm leading-relaxed">{g.blurb}</p>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</Layout>
