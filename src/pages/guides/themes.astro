---
import FeaturesLayout from '../../layouts/FeaturesLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import defaultCss from '../../styles/vendor/compodocx/compodocx.css?raw';
import oceanCss from '../../styles/vendor/compodocx/themes/ocean.css?raw';
import midnightCss from '../../styles/vendor/compodocx/themes/midnight.css?raw';
import nordCss from '../../styles/vendor/compodocx/themes/nord.css?raw';
import rosePineCss from '../../styles/vendor/compodocx/themes/rose-pine.css?raw';
import emberCss from '../../styles/vendor/compodocx/themes/ember.css?raw';
import neonCss from '../../styles/vendor/compodocx/themes/neon.css?raw';
import brutalistCss from '../../styles/vendor/compodocx/themes/brutalist.css?raw';

const SWATCH_TOKENS = [
  '--color-cdx-bg',
  '--color-cdx-bg-elevated',
  '--color-cdx-bg-alt',
  '--color-cdx-primary',
  '--color-cdx-text',
];

/**
 * Extract the contents of the `.dark { ... }` block via brace-balanced walk.
 * Returns an empty string if the theme has no `.dark` override (rare).
 */
function extractDarkBlock(css: string): string {
  const start = css.match(/(?:^|[^a-zA-Z0-9_-])\.dark\s*\{/);
  if (!start || start.index === undefined) return '';
  const open = css.indexOf('{', start.index);
  if (open === -1) return '';
  let depth = 1;
  let i = open + 1;
  while (i < css.length && depth > 0) {
    if (css[i] === '{') depth++;
    else if (css[i] === '}') depth--;
    i++;
  }
  return css.slice(open + 1, i - 1);
}

function extractTokens(css: string): Record<string, string> {
  const out: Record<string, string> = {};
  for (const token of SWATCH_TOKENS) {
    const match = css.match(new RegExp(`${token}\\s*:\\s*([^;]+);`));
    if (match) out[token] = match[1].trim();
  }
  return out;
}

function extractLightAndDark(css: string): {
  light: Record<string, string>;
  dark: Record<string, string>;
} {
  const light = extractTokens(css);
  const darkBlock = extractDarkBlock(css);
  const dark = darkBlock ? extractTokens(darkBlock) : {};
  // Fill missing dark tokens with their light value so the swatch has something to render.
  for (const token of SWATCH_TOKENS) {
    if (!dark[token]) dark[token] = light[token];
  }
  return { light, dark };
}

const howToJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Author a custom compodocx theme',
  description:
    'Three steps to ship your own compodocx theme: write a CSS file overriding --color-cdx-* tokens for light and dark, then pass it via --theme.',
  totalTime: 'PT10M',
  tool: [{ '@type': 'HowToTool', name: '@cngxjs/compodocx' }],
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Create a brand CSS file',
      text: 'Create my-brand.css next to your tsconfig. Open with :root { } for the light mode block and .dark { } for the dark mode block.',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Override --color-cdx-* tokens',
      text: 'Set --color-cdx-bg, --color-cdx-text, --color-cdx-primary, and any other tokens you want to brand. Unspecified tokens fall back to the default theme.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Pass the file to compodocx',
      text: 'Run compodocx with --theme ./my-brand.css. The theme is bundled into the static output and applies before paint, no FOUC.',
    },
  ],
};

interface Bundled {
  name: string;
  flag: string;
  blurb: string;
  light: Record<string, string>;
  dark: Record<string, string>;
}

const bundled: Bundled[] = [
  {
    name: 'Slate Noir',
    flag: 'default',
    blurb: 'Pure neutral greys. The opinion-free default.',
    ...extractLightAndDark(defaultCss),
  },
  {
    name: 'Ocean',
    flag: 'ocean',
    blurb: 'Deep teal, cool surfaces, soft tension borders.',
    ...extractLightAndDark(oceanCss),
  },
  {
    name: 'Midnight',
    flag: 'midnight',
    blurb: 'Indigo night, low contrast, focus-friendly.',
    ...extractLightAndDark(midnightCss),
  },
  {
    name: 'Nord',
    flag: 'nord',
    blurb: 'Arctic palette, frost blue, calm primary.',
    ...extractLightAndDark(nordCss),
  },
  {
    name: 'Rose Pine',
    flag: 'rose-pine',
    blurb: 'Warm rose, muted greens, golden accents.',
    ...extractLightAndDark(rosePineCss),
  },
  {
    name: 'Ember',
    flag: 'ember',
    blurb: 'Warm amber on ember-grey, low-glare reading.',
    ...extractLightAndDark(emberCss),
  },
  {
    name: 'Neon',
    flag: 'neon',
    blurb: 'High-contrast electric primary on dark slate.',
    ...extractLightAndDark(neonCss),
  },
  {
    name: 'Brutalist',
    flag: 'brutalist',
    blurb: 'Hard edges, raw concrete, maximum legibility.',
    ...extractLightAndDark(brutalistCss),
  },
];

interface TokenGroup {
  id: string;
  name: string;
  count: string;
  blurb: string;
  css: string;
}

const tokenGroups: TokenGroup[] = [
  {
    id: 'surface',
    name: 'Surface hierarchy',
    count: '5',
    blurb:
      'Page, sidebar, cards, inline-code, fenced-code-block. The full vertical stack of background layers.',
    css: `--color-cdx-bg:            hsl(220 16% 98%);
--color-cdx-bg-alt:        hsl(220 16% 96%);
--color-cdx-bg-elevated:   hsl(0 0% 100%);
--color-cdx-bg-code:       hsl(220 16% 95%);
--color-cdx-bg-code-block: hsl(225 16% 16%);`,
  },
  {
    id: 'text',
    name: 'Text hierarchy',
    count: '4',
    blurb: 'Body, secondary, muted, and inverse. Match contrast carefully against the surfaces.',
    css: `--color-cdx-text:           hsl(220 20% 14%);
--color-cdx-text-secondary: hsl(220 12% 44%);
--color-cdx-text-muted:     hsl(220 10% 45%);
--color-cdx-text-inverse:   hsl(220 16% 96%);`,
  },
  {
    id: 'primary',
    name: 'Primary accent',
    count: '3',
    blurb: 'Brand color, hover variant, and a subtle tint for backgrounds and rings.',
    css: `--color-cdx-primary:        hsl(222 68% 52%);
--color-cdx-primary-hover:  hsl(222 68% 44%);
--color-cdx-primary-subtle: hsl(222 68% 96%);`,
  },
  {
    id: 'entity',
    name: 'Entity-type accents',
    count: '13',
    blurb:
      'One color per entity kind. Used for sidebar dots, type chips, and dependency-graph nodes.',
    css: `--color-cdx-entity-component:   #0e8578;
--color-cdx-entity-service:     #a56a07;
--color-cdx-entity-directive:   #7c3aed;
