--color-cdx-border-strong: hsl(220 14% 59%);
--color-cdx-border-focus:  hsl(222 68% 52%);
--shadow-cdx-sm: 0 1px 2px hsl(220 20% 14% / 0.06);
--shadow-cdx-md: 0 4px 12px hsl(220 20% 14% / 0.08);
--shadow-cdx-lg: 0 12px 32px hsl(220 20% 14% / 0.12);`,
  },
  {
    id: 'typography',
    name: 'Typography',
