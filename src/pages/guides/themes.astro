--color-cdx-badge-token:               hsl(260 50% 48%);
--color-cdx-badge-beta:                hsl(35 75% 42%);
--color-cdx-badge-factory:             hsl(200 50% 42%);
--color-cdx-badge-zoneless:            hsl(280 45% 48%);
--color-cdx-badge-breaking:            hsl(0 65% 45%);
--color-cdx-badge-signal:              hsl(210 60% 42%);
--color-cdx-badge-computed:            hsl(270 50% 45%);
--color-cdx-badge-effect:              hsl(45 70% 40%);
--color-cdx-badge-resource:            hsl(190 55% 38%);
--color-cdx-badge-model:               hsl(240 45% 45%);
--color-cdx-badge-after-render:        hsl(25 65% 40%);
--color-cdx-badge-after-next-render:   hsl(15 65% 42%);
