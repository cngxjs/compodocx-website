--color-cdx-entity-variable:    #617087;
--color-cdx-entity-typealias:   #6164f1;
--color-cdx-entity-enum:        #c2410c;`,
  },
  {
    id: 'badges',
    name: 'Badge base colors',
    count: '21',
    blurb:
