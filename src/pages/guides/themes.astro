---
import FeaturesLayout from '../../layouts/FeaturesLayout.astro';
const codeBlock =
  'bg-cdx-bg-alt/60 text-cdx-text overflow-x-auto rounded-lg p-3 font-mono text-xs leading-relaxed';
const inlineCode = 'text-cdx-text bg-cdx-bg-alt rounded px-1 py-0.5 font-mono text-[0.85em]';

const bundled = [
  ['Slate Noir', 'Pure neutral greys. The opinion-free default.'],
  ['Ocean', 'Deep teal, cool surfaces, soft tension borders.'],
  ['Midnight', 'Indigo night, low contrast, focus-friendly.'],
  ['Nord', 'Arctic palette, frost blue, calm primary.'],
  ['Rose Pine', 'Warm rose, muted greens, golden accents.'],
  ['Ember', 'Warm amber on ember-grey, low-glare reading.'],
  ['Neon', 'High-contrast electric primary on dark slate.'],
  ['Brutalist', 'Hard edges, raw concrete, maximum legibility.'],
];
---

<FeaturesLayout
  currentSlug="themes"
  title="Themes — compodocx"
  description="Eight bundled compodocx themes — Slate Noir, Ocean, Midnight, Nord, Rose Pine, Ember, Neon, Brutalist. Author your own by overriding --color-cdx-* tokens."
>
  <p class="text-cdx-text-secondary text-lg">
    Eight themes ship in the box. A theme is a CSS file that overrides the
    <code class={inlineCode}>--color-cdx-*</code> tokens — semantic variables for backgrounds, text, primary,
    surface elevation, badges, code blocks, scrollbars, and graph chrome.
  </p>

  <h2 class="text-cdx-text text-xl font-semibold mt-12 first:mt-0">Bundled themes</h2>
  <ul class="text-cdx-text-secondary grid gap-2 text-sm md:grid-cols-2">
    {
      bundled.map(([name, blurb]) => (
        <li>
          <span class="text-cdx-text font-semibold">{name}</span> — {blurb}
        </li>
      ))
    }
  </ul>
  <p class="text-cdx-text-secondary pt-4">
    Each theme picks a Shiki light/dark pair to match — Ocean uses
    <code class={inlineCode}>github-light</code> / <code class={inlineCode}>github-dark</code>,
    Midnight uses <code class={inlineCode}>tokyo-night</code>, Neon uses <code class={inlineCode}
      >synthwave-84</code
    >, and so on.
  </p>

  <h2 class="text-cdx-text text-xl font-semibold mt-12 first:mt-0">Switching themes</h2>
  {/* prettier-ignore */}
  <pre class:list={codeBlock}><code>--theme ocean
--theme ./my-brand.css</code></pre>

  <h2 class="text-cdx-text text-xl font-semibold mt-12 first:mt-0">Custom themes</h2>
  <p class="text-cdx-text-secondary">
    A custom theme is one CSS file overriding any subset of the
    <code class={inlineCode}>--color-cdx-*</code> tokens. Unspecified tokens fall back to the default.
    Override prefixes include <code class={inlineCode}>--color-cdx-*</code>,
    <code class={inlineCode}>--spacing-cdx-*</code>, <code class={inlineCode}>--radius-cdx-*</code>,
    <code class={inlineCode}>--shadow-cdx-*</code>, <code class={inlineCode}>--cdx-badge-*</code>,
    and
    <code class={inlineCode}>--cdx-mod-*</code>.
  </p>

  {/* prettier-ignore */}
  <pre
    class:list={codeBlock}><code>{`:root {
  --color-cdx-bg: hsl(220 20% 96%);
  --color-cdx-text: hsl(220 30% 12%);
  --color-cdx-primary: hsl(220 70% 40%);
}

.dark {
  --color-cdx-bg: hsl(220 25% 8%);
  --color-cdx-text: hsl(220 15% 92%);
  --color-cdx-primary: hsl(220 80% 65%);
}`}</code></pre>

  <h2 class="text-cdx-text text-xl font-semibold mt-12 first:mt-0">Per-component theming tokens</h2>
  <p class="text-cdx-text-secondary">
    Components can document their own theming surface via JSDoc on the component&rsquo;s associated
    SCSS / CSS file: <code class={inlineCode}>@overview</code> for a description,
    <code class={inlineCode}>@type</code> / <code class={inlineCode}>@default</code> /
    <code class={inlineCode}>@group</code> per token, plus <code class={inlineCode}>@example</code>,
    <code class={inlineCode}>@since</code>, <code class={inlineCode}>@deprecated</code>, and
    <code class={inlineCode}>@see</code>. Each component page surfaces a <em>Theming Tokens</em> tab with
    a grouped catalog and an optional source preview.
  </p>
</FeaturesLayout>
