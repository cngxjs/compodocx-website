---
import FeaturesLayout from '../../layouts/FeaturesLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';

const howToJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Author a custom compodocx theme',
  description:
    'Three steps to ship your own compodocx theme: write a CSS file overriding --color-cdx-* tokens for light and dark, then pass it via --theme.',
  totalTime: 'PT10M',
  tool: [{ '@type': 'HowToTool', name: '@cngxjs/compodocx' }],
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Create a brand CSS file',
      text: 'Create my-brand.css next to your tsconfig. Open with :root { } for the light mode block and .dark { } for the dark mode block.',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Override --color-cdx-* tokens',
      text: 'Set --color-cdx-bg, --color-cdx-text, --color-cdx-primary, and any other tokens you want to brand. Unspecified tokens fall back to the default theme.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Pass the file to compodocx',
      text: 'Run compodocx with --theme ./my-brand.css. The theme is bundled into the static output and applies before paint, no FOUC.',
    },
  ],
};

const bundled = [
  ['Slate Noir', 'Pure neutral greys. The opinion-free default.'],
  ['Ocean', 'Deep teal, cool surfaces, soft tension borders.'],
  ['Midnight', 'Indigo night, low contrast, focus-friendly.'],
  ['Nord', 'Arctic palette, frost blue, calm primary.'],
  ['Rose Pine', 'Warm rose, muted greens, golden accents.'],
  ['Ember', 'Warm amber on ember-grey, low-glare reading.'],
  ['Neon', 'High-contrast electric primary on dark slate.'],
  ['Brutalist', 'Hard edges, raw concrete, maximum legibility.'],
];
---

<FeaturesLayout
  currentSlug="themes"
  title="Themes — 8 bundled palettes & custom themes in compodocx"
  description="Eight bundled compodocx themes — Slate Noir, Ocean, Midnight, Nord, Rose Pine, Ember, Neon, Brutalist. Author your own by overriding --color-cdx-* tokens."
  extraJsonLd={howToJsonLd}
>
  <p class="text-cdx-text-secondary text-lg">
    Eight themes ship in the box. A theme is a CSS file that overrides the
    <code class="cdx-code">--color-cdx-*</code> tokens. Semantic variables for backgrounds, text, primary,
    surface elevation, badges, code blocks, scrollbars, and graph chrome.
  </p>

  <h2>Bundled themes</h2>
  <ul class="text-cdx-text-secondary grid gap-2 text-sm md:grid-cols-2">
    {
      bundled.map(([name, blurb]) => (
        <li>
          <span class="text-cdx-text font-semibold">{name}</span> — {blurb}
        </li>
      ))
    }
  </ul>
  <p class="pt-4">
    Each theme picks a Shiki light/dark pair to match. Ocean uses
    <code class="cdx-code">github-light</code> / <code class="cdx-code">github-dark</code>, Midnight
    uses <code class="cdx-code">tokyo-night</code>, Neon uses <code class="cdx-code"
      >synthwave-84</code
    >, and so on.
  </p>

  <h2>Switching themes</h2>
  <CodeBlock
    lang="bash"
    code={`--theme ocean
--theme ./my-brand.css`}
  />

  <h2>Custom themes</h2>
  <p>
    A custom theme is one CSS file overriding any subset of the
    <code class="cdx-code">--color-cdx-*</code> tokens. Unspecified tokens fall back to the default. Override
    prefixes include <code class="cdx-code">--color-cdx-*</code>,
    <code class="cdx-code">--spacing-cdx-*</code>, <code class="cdx-code">--radius-cdx-*</code>,
    <code class="cdx-code">--shadow-cdx-*</code>, <code class="cdx-code">--cdx-badge-*</code>, and
    <code class="cdx-code">--cdx-mod-*</code>.
  </p>

  <CodeBlock
    lang="css"
    filename="my-brand.css"
    code={`:root {
  --color-cdx-bg: hsl(220 20% 96%);
  --color-cdx-text: hsl(220 30% 12%);
  --color-cdx-primary: hsl(220 70% 40%);
}

.dark {
  --color-cdx-bg: hsl(220 25% 8%);
  --color-cdx-text: hsl(220 15% 92%);
  --color-cdx-primary: hsl(220 80% 65%);
}`}
  />

  <h2>Per-component theming tokens</h2>
  <p>
    Components can document their own theming surface via JSDoc on the component&rsquo;s associated
    SCSS / CSS file: <code class="cdx-code">@overview</code> for a description,
    <code class="cdx-code">@type</code> / <code class="cdx-code">@default</code> /
    <code class="cdx-code">@group</code> per token, plus <code class="cdx-code">@example</code>,
    <code class="cdx-code">@since</code>, <code class="cdx-code">@deprecated</code>, and
    <code class="cdx-code">@see</code>. Each component page surfaces a <em>Theming Tokens</em> tab with
    a grouped catalog and an optional source preview.
  </p>
</FeaturesLayout>
