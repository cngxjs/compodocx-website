---
import FeaturesLayout from '../../layouts/FeaturesLayout.astro';
const codeBlock =
  'bg-cdx-bg-alt/60 text-cdx-text overflow-x-auto rounded-lg p-3 font-mono text-xs leading-relaxed';
const inlineCode = 'text-cdx-text bg-cdx-bg-alt rounded px-1 py-0.5 font-mono text-[0.85em]';
---

<FeaturesLayout
  currentSlug="live-example"
  title="Live Example Tab — compodocx"
  description="Sandboxed runnable demos rendered alongside component source via @example tags."
>
  <p class="text-cdx-text-secondary text-lg">
    Components can carry executable demos. Examples written via
    <code class={inlineCode}>@example</code> render in a sandboxed iframe alongside the source. Edit-and-rerun
    is wired up via a small in-page editor.
  </p>

  {/* prettier-ignore */}
  <pre
    class:list={codeBlock}><code>{`/**
 * @example
 * <cngx-card as="button" [selectable]="true">
 *   <header cngxCardHeader><h3>Patient</h3></header>
 *   <div cngxCardBody>Details here</div>
 * </cngx-card>
 */
@Component({ ... })
export class CardComponent { ... }`}</code></pre>

  <h2 class="text-cdx-text text-xl font-semibold mt-12 first:mt-0">Enabling the tab</h2>
  {/* prettier-ignore */}
  <pre class:list={codeBlock}><code>npx compodocx --liveExamples</code></pre>

  <p class="text-cdx-text-secondary">
    The sandbox loads only the component under test plus its declared peerDependencies — no full app
    bundle. First example loads in roughly 250 ms; subsequent ones reuse the runtime.
  </p>

  <h2 class="text-cdx-text text-xl font-semibold mt-12 first:mt-0">Multiple examples per symbol</h2>
  <p class="text-cdx-text-secondary">
    Repeat the <code class={inlineCode}>@example</code> tag with a heading on the first line and the body
    indented underneath:
  </p>

  {/* prettier-ignore */}
  <pre
    class:list={codeBlock}><code>{`/**
 * @example Article card
 *   <cngx-card>...</cngx-card>
 *
 * @example Action card
 *   <cngx-card as="button" [selectable]="true">...</cngx-card>
 */`}</code></pre>
</FeaturesLayout>
