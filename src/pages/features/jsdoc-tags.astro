---
import FeaturesLayout from '../../layouts/FeaturesLayout.astro';
const inlineCode = 'text-cdx-text bg-cdx-bg-alt rounded px-1 py-0.5 font-mono text-[0.85em]';

const tags = [
  ['@param', 'parameter docs (auto-paired with TypeScript types)'],
  ['@returns', 'return value description'],
  ['@example', 'code example block, syntax-highlighted'],
  ['@deprecated', 'strikethrough + warning banner'],
  ['@internal', 'hides the symbol from public docs'],
  ['@ignore', 'hides a single member without affecting siblings'],
  ['@see', 'appends a See-also link block'],
  ['@since', 'renders a small version label'],
  ['@link', 'inline cross-reference, resolved during build'],
  ['@throws', 'documented error case, rendered as a callout'],
  ['@experimental', 'tags the symbol as unstable'],
  ['@public', 'force-include a symbol that would otherwise be hidden'],
];
---

<FeaturesLayout
  currentSlug="jsdoc-tags"
  title="JSDoc Tags — compodocx"
  description="Recognized JSDoc tags and how compodocx renders each one."
>
  <p class="text-cdx-text-secondary text-lg">
    Recognized tags out of the box, ordered roughly by how often they appear in real Angular
    projects.
  </p>

  <dl class="grid gap-3 text-sm md:grid-cols-[auto_1fr] md:gap-x-6">
    {
      tags.map(([tag, desc]) => (
        <>
          <dt class="text-cdx-text">
            <code class={inlineCode}>{tag}</code>
          </dt>
          <dd class="text-cdx-text-secondary">{desc}</dd>
        </>
      ))
    }
  </dl>

  <p class="text-cdx-text-secondary pt-4">
    Unrecognized tags pass through to the description block verbatim — useful for custom annotations
    that downstream consumers grep for.
  </p>
</FeaturesLayout>
