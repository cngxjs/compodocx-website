---
import FeaturesLayout from '../../layouts/FeaturesLayout.astro';
const inlineCode = 'text-cdx-text bg-cdx-bg-alt rounded px-1 py-0.5 font-mono text-[0.85em]';

const options = [
  ['--tsconfig, -p', 'entry tsconfig'],
  ['--output, -d', 'output directory'],
  ['--theme', 'built-in name or path to a CSS file'],
  ['--exportFormat', 'html | llm-md | json'],
  ['--showEffects', 'include effects in component output'],
  ['--versionLabel', 'pin the label (auto-detected from package.json)'],
  ['--watch', 're-build on file changes'],
  ['--serve', 'dev server with live reload'],
  ['--coverageMinimum', 'CI gate threshold (0–100)'],
  ['--basePath', 'sub-path host (GitHub Pages, S3 prefix)'],
  ['--routingMode', 'history (default) or hash'],
  ['--searchIndex', 'enable / disable Pagefind index generation'],
];
---

<FeaturesLayout
  currentSlug="options"
  title="Options — compodocx"
  description="CLI flags and JSON config keys for compodocx — the surface that controls what ends up in your docs."
>
  <p class="text-cdx-text-secondary text-lg">
    compodocx accepts CLI flags or a JSON config. The two compose: flags override config values. Use
    the config for team consistency, flags for one-off runs.
  </p>

  <h2 class="text-cdx-text text-xl font-semibold mt-12 first:mt-0">Frequently used options</h2>
  <dl class="grid gap-3 text-sm md:grid-cols-[auto_1fr] md:gap-x-6">
    {
      options.map(([flag, desc]) => (
        <>
          <dt class="text-cdx-text">
            <code class={inlineCode}>{flag}</code>
          </dt>
          <dd class="text-cdx-text-secondary">{desc}</dd>
        </>
      ))
    }
  </dl>

  <p class="text-cdx-text-secondary pt-4">
    Run <code class={inlineCode}>compodocx --help</code> for the full list, including project-level options
    (tab registry, custom tabs, sidebar overrides) that don&rsquo;t fit a flag.
  </p>
</FeaturesLayout>
