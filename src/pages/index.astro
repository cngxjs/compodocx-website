---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StatusBadges from '../components/StatusBadges.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Screenshots from '../components/Screenshots.astro';
import CoverageSection from '../components/CoverageSection.astro';
import MultiVersionSection from '../components/MultiVersionSection.astro';
import MigrationCallout from '../components/MigrationCallout.astro';
import GettingStarted from '../components/GettingStarted.astro';
import ThemesGrid from '../components/ThemesGrid.astro';

const buildDate = new Date().toISOString().slice(0, 10);

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'compodocx',
  alternateName: '@cngxjs/compodocx',
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'Documentation Generator',
  operatingSystem: 'Cross-platform (Node.js)',
  description:
    'Modern documentation generator for Angular applications. Standalone-first, Signals, theming tokens, multi-version output, migration tools.',
  url: 'https://www.npmjs.com/package/@cngxjs/compodocx',
  downloadUrl: 'https://www.npmjs.com/package/@cngxjs/compodocx',
  installUrl: 'https://www.npmjs.com/package/@cngxjs/compodocx',
  softwareVersion: '0.3.0',
  softwareRequirements: 'Node.js >= 22',
  datePublished: '2026-04-01',
  dateModified: buildDate,
  license: 'https://opensource.org/license/MIT',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Organization',
    name: 'cngxjs',
    url: 'https://github.com/cngxjs',
  },
  maintainer: {
    '@type': 'Organization',
    name: 'cngxjs',
    url: 'https://github.com/cngxjs',
  },
  programmingLanguage: 'TypeScript',
  keywords:
    'angular documentation, compodoc fork, standalone components, signals, multi-version, jsdoc',
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is compodocx compatible with compodoc?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. compodocx is a drop-in fork. The compodoc CLI alias still works, and a compodocx migrate command ports Handlebars overrides to JS partials automatically.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does compodocx support Angular Signals and standalone components?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. signal, computed, and linked-signal members render as first-class fields with derived-state dependencies. Standalone components, directives, and pipes are documented without NgModule scaffolding.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I generate docs for multiple library versions?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Multi-version output is the default. compodocx detects the version from package.json, writes a versions.json manifest, and ships a runtime version-switcher widget — no server-side config needed.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I theme compodocx output?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Eight themes ship in the box (Slate Noir, Ocean, Midnight, Nord, Rose Pine, Ember, Neon, Brutalist). Roll your own by overriding any subset of the --color-cdx-* CSS custom properties in a single CSS file passed via --theme.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does compodocx integrate with CI?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. compodocx diff compares two JSON snapshots and exits non-zero on breaking changes. --exportFormat json emits a typed schema with schemaVersion. --coverageMinimum gates merges on documentation completeness.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is compodocx free?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. compodocx is open source under the MIT license. The compodoc upstream attribution to Vincent Ogloblinsky is preserved.',
      },
    },
  ],
};
---

<Layout
  title="compodocx — Angular docs with Signals & multi-version output"
  description="Static Angular documentation generator. Standalone, signals, multi-version output, theming, LLM export — all from one CLI. MIT, Node 22+."
  jsonLd={[softwareJsonLd, faqJsonLd]}
>
  <Hero />
  <StatusBadges />
  <FeatureGrid />
  <Screenshots />
  <CoverageSection />
  <MultiVersionSection />
  <MigrationCallout />
  <GettingStarted />
  <ThemesGrid />
</Layout>
