---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StatusBadges from '../components/StatusBadges.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Screenshots from '../components/Screenshots.astro';
import CoverageSection from '../components/CoverageSection.astro';
import MultiVersionSection from '../components/MultiVersionSection.astro';
import MigrationCallout from '../components/MigrationCallout.astro';
import GettingStarted from '../components/GettingStarted.astro';
import ThemesGrid from '../components/ThemesGrid.astro';
import PlaygroundCallout from '../components/PlaygroundCallout.astro';
import FAQSection, { faq } from '../components/FAQSection.astro';

const buildDate = new Date().toISOString().slice(0, 10);

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'compodocx',
  alternateName: '@cngxjs/compodocx',
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'Documentation Generator',
  operatingSystem: 'Cross-platform (Node.js)',
  description:
    'Modern documentation generator for Angular applications. Standalone-first, Signals, theming tokens, multi-version output, migration tools.',
  url: 'https://www.npmjs.com/package/@cngxjs/compodocx',
  downloadUrl: 'https://www.npmjs.com/package/@cngxjs/compodocx',
  installUrl: 'https://www.npmjs.com/package/@cngxjs/compodocx',
  softwareVersion: '0.3.0',
  softwareRequirements: 'Node.js >= 22',
  datePublished: '2026-04-01',
  dateModified: buildDate,
  license: 'https://opensource.org/license/MIT',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Organization',
    name: 'cngxjs',
    url: 'https://github.com/cngxjs',
  },
  maintainer: {
    '@type': 'Organization',
    name: 'cngxjs',
    url: 'https://github.com/cngxjs',
  },
  programmingLanguage: 'TypeScript',
  keywords:
    'angular documentation, compodoc fork, standalone components, signals, multi-version, jsdoc',
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Layout
  title="compodocx - Angular docs with Signals & multi-version output"
  description="Static Angular documentation generator. Standalone, signals, themable, multi-version output, runnable StackBlitz playgrounds, LLM export - all from one CLI."
  keywords={[
    'angular documentation',
    'compodocx',
    'compodoc fork',
    'angular standalone',
    'angular signals',
    'jsdoc angular',
    'typescript documentation',
    'static documentation generator',
    'angular cli docs',
    'multi-version docs',
    'stackblitz playground',
    'runnable angular demos',
  ]}
  jsonLd={[softwareJsonLd, faqJsonLd]}
>
  <Hero />
  <StatusBadges />
  <FeatureGrid />
  <Screenshots />
  <CoverageSection />
  <MultiVersionSection />
  <PlaygroundCallout />
  <MigrationCallout />
  <GettingStarted />
  <ThemesGrid />
  <FAQSection />
</Layout>
